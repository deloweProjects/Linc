<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>linc-appssim</AssemblyName>
    <RootNamespace>Linc.AppsSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compiled verbatim from Linc.Desktop — only the dependency-free sources, the same
      posture as displaysim / homelayoutsim (D-036 / D-037). AppsPayload.cs is the single
      place the runtime AND this harness parse the v16 `apps` reply, and AppCatalog.cs is
      the single place either writes the per-device cache, so what is proven here is what
      the app actually does. DeviceRegistry comes along because the cache root must be
      taken from it (D-057/D-058) and that link is one of the things under test.
    -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\AppsPayload.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\AppCatalog.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DeviceRegistry.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HomeLayout.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DesktopModeSettings.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\MirrorSettings.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\ToolLocator.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LogService.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DisplayPayload.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincException.cs" />
  </ItemGroup>
</Project>
