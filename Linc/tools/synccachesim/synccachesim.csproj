<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>linc-synccachesim</AssemblyName>
    <RootNamespace>Linc.SyncCacheSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compiled verbatim from Linc.Desktop — only the dependency-free sources, the same posture as
      homecachesim / outboxsim / storesim / displaysim / homelayoutsim (D-036/D-037). LincStore.cs
      is the single place the runtime AND this harness build the sync_cache schema and run the
      real upsert/list/prune/count methods, so what is proven here is what the app does.
      HomeCacheFormat.cs brings in the real HomeOfflineBanner.FormatText and the Cached* payload
      records/HomeCacheKinds that both HomeViewModel AND SyncViewModel now write through to
      (M9d-2, §3.1/§3.5) — the SAME table, same kinds, no second cache layer.

      OutboxService.cs is compiled in full (same posture as outboxsim) so its pure static
      MatchesFlushedRow (M9d-2, §3.4) is exercised directly rather than modelled — the §4.2
      lesson. Its constructor takes IConnectionSupervisor / IConnectionManager, so this file
      declares the SAME minimal STUB interfaces + LinkState enum outboxsim already declares,
      purely so OutboxService.cs compiles; the stubs take no part in any check below.
      DeviceRegistry stays the real IDeviceRegistry, same as outboxsim/storesim.
    -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincStore.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HomeCacheFormat.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DeviceRegistry.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\OutboxService.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HomeLayout.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DesktopModeSettings.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\MirrorSettings.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\ToolLocator.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LogService.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincException.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirrors Linc.Desktop.csproj: Microsoft.Data.Sqlite is the M9a foundation (D-044).
         Pinned to the same 8.0.29 patch so the app and this harness share one resolved version. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>
</Project>
