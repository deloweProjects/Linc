<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>linc-linclinksim</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- LincLink's pure core (Vibe/agent/design/linclink.md), compiled verbatim from the app: no
         sockets, no adb, no phone, no settings file touched. -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\LinkSession.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\LinkBeacon.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\LinkPairing.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\NetMemory.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\RouteRace.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\LinkBrain.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincLink\DialBackWaiters.cs" />
    <!-- The PC's real protocol client, run against a fake v32 phone over in-memory links (ClientSim.cs). -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\CompanionClient.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincException.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\AppsPayload.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DisplayPayload.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Protocol\Envelope.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Protocol\Framing.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Provenance.cs" />
  </ItemGroup>
</Project>
