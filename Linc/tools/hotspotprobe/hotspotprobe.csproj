<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>linc-hotspotprobe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The production role rule, address filter, adb connect sequence and adb locator,
         compiled verbatim (D-036 pattern). This probe deliberately owns NO logic of its own
         about roles, subnets or connect ordering: what the owner sees on a real hotspot has
         to be what Linc itself would decide, or the diagnostic is measuring the wrong
         program. LogService.cs comes along only because HotspotConnector takes an optional
         ILogService (it is passed null here). -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HotspotRole.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HotspotAddress.cs" />
    <!-- HotspotConnect.cs now delegates its endpoint building to HotspotEndpoint.cs and its
         identity check to HotspotAnnounce.VerifySerial — both pure, compiled verbatim so the
         probe exercises the real production sequence. -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HotspotEndpoint.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HotspotAnnounce.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HotspotConnect.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\ToolLocator.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LogService.cs" />
  </ItemGroup>
</Project>
