<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>linc-homecachesim</AssemblyName>
    <RootNamespace>Linc.HomeCacheSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compiled verbatim from Linc.Desktop — only the dependency-free sources, the same posture
      as storesim / outboxsim / displaysim / homelayoutsim (D-036 / D-037). LincStore.cs is the
      single place the runtime AND this harness build the sync_cache schema and run the typed
      upsert/list/prune/count methods, so what is proven here is what the app does.
      HomeCacheFormat.cs brings in the pure HomeOfflineBanner.FormatText static (M9d-1 §2.5) so
      the harness calls the real banner-text formatter instead of modelling it (§4.1's lesson).
      DeviceRegistry comes along only because LincStore.cs's convenience constructor overload
      references IDeviceRegistry — this harness never constructs a DeviceRegistry itself, so
      homelayoutsim's D-057 "explicit root" scan has nothing of this file's to flag.
    -->
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincStore.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HomeCacheFormat.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DeviceRegistry.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\HomeLayout.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\DesktopModeSettings.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\MirrorSettings.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\ToolLocator.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LogService.cs" />
    <Compile Include="..\..\DESKTOP\Linc.Desktop\Services\LincException.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirrors Linc.Desktop.csproj: Microsoft.Data.Sqlite is the M9a foundation (D-044).
         Pinned to the same 8.0.29 patch so the app and this harness share one resolved version. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>
</Project>
