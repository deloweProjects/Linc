<Project Sdk="Microsoft.NET.Sdk">

  <!--
    appgridprobe (M7b) — the one harness in tools/ that needs a real WinUI layout pass.

    Everything else about the Apps grid can be proven from a console: the command line, the store,
    the on-screen rule, the XAML's shape. "Only a screenful of tiles is realized" cannot be — it is
    a claim about ItemsRepeater's virtualization, which only exists when a real ScrollViewer
    measures a real repeater. So this project builds the SAME control arrangement the Apps card
    uses (ScrollViewer -> ItemsRepeater -> UniformGridLayout, the same tile metrics), fills it with
    a few hundred items, and prints how many tiles the repeater actually realized.

    It is a console app (OutputType Exe) that happens to host WinUI, so its numbers land in the
    build log. It touches no store, no phone and no network (D-057: it has no store to point
    anywhere). Deliberately NOT in Linc.Desktop.sln — the desktop build must not depend on it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AssemblyName>linc-appgridprobe</AssemblyName>
    <RootNamespace>Linc.AppGridProbe</RootNamespace>
    <!-- The probe supplies its own Main (Program.cs) so it can print and set an exit code. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

</Project>
