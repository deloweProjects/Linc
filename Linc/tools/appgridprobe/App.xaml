<Application
    x:Class="Linc.AppGridProbe.ProbeApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        This file exists for one reason: a WinUI Application needs a generated XAML metadata
        provider, and that is only generated for a project that has XAML in it. The probe's own
        controls are all built in code (Program.cs) so the arrangement under test is unambiguous.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
