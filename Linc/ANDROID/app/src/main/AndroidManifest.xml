<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v9 Direct TLS transport: dial the desktop over LAN (D-022). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PC Remote (D-069): voice typing on the floating keyboard, and the phone as the PC's
         microphone for Windows Voice Access. Asked for at first use, never up front. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The phone as the PC's microphone (D-075): Android 14+ only lets a foreground service
         record with the screen off or Linc in the background when it is typed "microphone". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 14+ requires one "device interaction" permission alongside the
         connectedDevice FGS type; CHANGE_NETWORK_STATE is normal (auto-granted). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background clipboard (D-092). Both are granted by the PC over ADB, never asked for:
         READ_LOGS shows Linc the system's "denied clipboard access" line when something is
         copied, and the overlay grant lets it briefly show an invisible window to read the clip
         (Android 10+ lets only the focused app read the clipboard). Without them, phone-to-PC
         clipboard still works whenever Linc is open, as before. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        M17b C: lets Linc ask Android to open its own package installer for a downloaded update.
        It does NOT allow a silent install — Android still shows its confirmation, and the user
        must additionally grant "install unknown apps" for Linc before the request is honoured.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Normal permission, no runtime prompt; used only to read Wi-Fi signal
         strength/link speed for the Details page (never the SSID). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- LincLink (v32): start Linc after a restart (BootReceiver), and receive the PC's LAN beacon
         while the screen is off (a multicast lock, held only while no PC is connected). Both are
         normal permissions with no prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Normal permission, no runtime prompt. Needed to acquire the low-latency Wi-Fi lock the
         PC Remote screen holds while it is visible, which stops the radio's power-save mode
         from sleeping between beacons and delaying the mirror's packets (D-066). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets Settings show Android's own "allow Linc to run in the background" prompt. Without
         the exemption many phones freeze the app with the screen off and the PC link drops. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Special grant, sideload builds only (D-021): lets the desktop show the phone's
         wallpaper (as a tiny blurred thumbnail) behind the Home widgets. The user
         gives it explicitly from the Settings screen; everything works without it. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Messages lane (Sync page), sideload builds only (D-016/D-025). Sending needs
         only SEND_SMS — not default-SMS-app status. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Calls lane (Sync page), sideload builds only (D-016/D-026). No PC audio (D-017). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- BLE presence beacon (M04, D-034): advertise-only, so no scan permission and no
         location — the phone never looks for anything over Bluetooth and no data ever rides
         it. Everything degrades to a no-op without this grant. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- v15 display control (M5c, D-055): lets the PC's orientation/brightness widgets write
         Settings.System. This is an appop, not a runtime permission — declaring it grants
         nothing; the user toggles it under Settings > Apps > Special app access > Modify
         system settings, and DisplayControl.canWrite() re-checks before every write. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- v28: the PC's Device page sets this phone's wallpaper (a normal permission), and shows
         today's screen time. Usage access is an appop: declaring it grants nothing; the PC turns
         it on over USB debugging (appops set … GET_USAGE_STATS allow), or the user does under
         Settings > Apps > Special app access > Usage access. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- v18 / M13c: lets the companion arm wireless debugging itself
         (Settings.Global "adb_wifi_enabled"), so a hotspot link comes up with no cable and no
         trip into Developer options. This is a signature|privileged permission: DECLARING it
         grants nothing at all, and a normal install leaves it ungranted. It only becomes held
         when `pm grant` is run over an existing ADB session — which Linc's PC-driven onboarding
         already has, right after it installs this APK, so the user never touches ADB (D-001).
         A phone whose OEM refuses the grant simply keeps arming manual: AdbArming re-checks the
         permission before every write and reports `denied` rather than throwing. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- NFC tap-to-connect: a Linc sticker by the desk starts the link on tap. Optional
         hardware, so phones without NFC still install Linc. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Android 11+ package visibility: Quick Share (Google's in Play services, Samsung's
         Quick Share app) must be visible for the Share section to hand files to it directly. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.RECEIVE_NEARBY" />
            <data android:mimeType="*/*" />
        </intent>
        <package android:name="com.google.android.gms" />
        <package android:name="com.samsung.android.app.sharelive" />
    </queries>

    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Linc"
        android:supportsRtl="true">

        <!-- Authorship, stated openly (Provenance.kt, NOTICE). Read by nothing; informational. -->
        <meta-data
            android:name="app.linc.author"
            android:value="deloweProjects" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Direct Share target for the PC (1.0.0.11, D-083). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- PC Remote (M05): fullscreen landscape viewer for the PC's screen. Not exported;
             opened from the Home "Mirror PC" card only. -->
        <activity
            android:name=".MirrorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <!-- Tools (M4a): full-screen remote keyboard + trackpad. Not exported; opened from the
             Home "Tools" card only. -->
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Background clipboard (D-092): an invisible window that takes focus just long enough
             to read the clipboard and send it to the PC, then closes. Started by
             ClipboardWatcher only. -->
        <activity
            android:name=".ClipboardSyncActivity"
            android:exported="false"
            android:theme="@style/Theme.Linc.Invisible"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- NFC tap-to-connect: opened by the linc://tap record on a Linc desk tag. No UI;
             starts the companion, pokes the presence loop, finishes. -->
        <activity
            android:name=".NfcTapActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="linc" android:host="tap" />
            </intent-filter>
        </activity>

        <!-- LincLink: pairing by QR code. The PC's code is a linc://pair link the camera opens; the
             activity asks before pairing, since any app or page could open such a link. -->
        <activity
            android:name=".PairActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linc" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- LincLink: start after a restart or an update. BOOT_COMPLETED is a protected broadcast,
             so only the system can send it; the receiver also checks the action. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Serves received-file URIs to a viewer app when the user taps Open in the Share tab (M19). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Exported so the desktop can start the companion over ADB when it is not answering
            (M01, D-035) — `am start-foreground-service` is refused for a non-exported component
            ("Requires permission not exported from uid ..."), which is what forced a manual tap
            after every install, reboot or crash.

            Tradeoff: any app on the device can now start this service. That is a small delta —
            starting it only brings up a foreground service with a visible notification, and the
            socket it serves (`LocalServerSocket("linc")`) was already reachable by any app on the
            device, since abstract sockets carry no permission check. Nothing here grants a caller
            access to data it could not already request over that socket.
        -->
        <!-- Full-page tools opened from Tools: sound, PC look, terminal, files (D-097). -->
        <activity
            android:name=".PcToolActivity"
            android:exported="false"
            android:theme="@style/Theme.Linc" />

        <!-- Play everywhere with the phone as the source (D-097): Android's one-time consent to
             record what apps play. No UI of its own; it closes as soon as Android answers. -->
        <activity
            android:name=".CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Linc.Invisible" />

        <service
            android:name=".service.CompanionService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice|microphone|mediaProjection" />

        <service
            android:name=".service.LincNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
