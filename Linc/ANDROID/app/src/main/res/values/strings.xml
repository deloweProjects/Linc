<resources>
    <string name="app_name">Linc</string>

    <!-- Onboarding -->
    <string name="onboard_welcome_title">Welcome to Linc</string>
    <string name="onboard_welcome_body">Linc links this phone to your Windows PC — files, screen, clipboard and notifications. Setup takes about two minutes and you only do it once.</string>
    <string name="onboard_devoptions_title">Step 1: Enable developer options</string>
    <string name="onboard_devoptions_body">Open About phone and tap “Build number” seven times until you see “You are now a developer”. If you have already done this, just tap Next.</string>
    <string name="onboard_devoptions_action">Open About phone</string>
    <string name="onboard_wireless_title">Step 2: Turn on wireless debugging</string>
    <string name="onboard_wireless_body">In Developer options, find “Wireless debugging” and switch it on. Keep the phone on the same Wi-Fi network as your PC.</string>
    <string name="onboard_open_devsettings_action">Open Developer options</string>
    <string name="onboard_pair_title">Step 3: Pair with your PC</string>
    <string name="onboard_pair_body">Open Linc on your PC and choose “Pair phone”. Then, inside Wireless debugging on this phone, tap “Pair device with QR code” and scan the code your PC shows. Pairing with a 6-digit code works too.</string>
    <string name="onboard_done_title">All set!</string>
    <string name="onboard_done_body">Start the companion service on the next screen and your PC will take it from there. You will never need a cable or a terminal.</string>
    <string name="onboard_back">Back</string>
    <string name="onboard_next">Next</string>
    <string name="onboard_finish">Finish</string>

