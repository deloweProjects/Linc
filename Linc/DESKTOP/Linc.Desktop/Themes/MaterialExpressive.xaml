<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 Expressive design tokens over WinUI (docs/DECISIONS.md D-008):
  M3 color roles, full-radius shapes, and bold display typography.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="MdPrimary">#1A1A1A</Color>
            <Color x:Key="MdOnPrimary">#FFFFFF</Color>
            <Color x:Key="MdPrimaryContainer">#E6E6E6</Color>
            <Color x:Key="MdOnPrimaryContainer">#1A1A1A</Color>
            <Color x:Key="MdSecondaryContainer">#F2F2F2</Color>
            <Color x:Key="MdOnSecondaryContainer">#1A1A1A</Color>
            <Color x:Key="MdTertiaryContainer">#D9D9D9</Color>
            <Color x:Key="MdOnTertiaryContainer">#1A1A1A</Color>
            <Color x:Key="MdSurface">#FFFFFF</Color>
            <Color x:Key="MdOnSurface">#171717</Color>
            <Color x:Key="MdSurfaceContainer">#F7F7F7</Color>
            <Color x:Key="MdSurfaceContainerHigh">#ECECEC</Color>
            <Color x:Key="MdOnSurfaceVariant">#525252</Color>
            <Color x:Key="MdOutline">#7A7A7A</Color>
            <Color x:Key="MdOutlineVariant">#C6C6C6</Color>
            <Color x:Key="MdError">#B3261E</Color>
            <Color x:Key="MdErrorContainer">#F9DEDC</Color>
            <Color x:Key="MdOnErrorContainer">#8C1D18</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="MdPrimary">#E6E6E6</Color>
            <Color x:Key="MdOnPrimary">#1A1A1A</Color>
            <Color x:Key="MdPrimaryContainer">#3D3D3D</Color>
            <Color x:Key="MdOnPrimaryContainer">#E6E6E6</Color>
            <Color x:Key="MdSecondaryContainer">#484848</Color>
            <Color x:Key="MdOnSecondaryContainer">#E6E6E6</Color>
            <Color x:Key="MdTertiaryContainer">#5A5A5A</Color>
            <Color x:Key="MdOnTertiaryContainer">#E6E6E6</Color>
            <Color x:Key="MdSurface">#131313</Color>
            <Color x:Key="MdOnSurface">#E6E6E6</Color>
            <Color x:Key="MdSurfaceContainer">#1F1F1F</Color>
            <Color x:Key="MdSurfaceContainerHigh">#2A2A2A</Color>
            <Color x:Key="MdOnSurfaceVariant">#C9C9C9</Color>
            <Color x:Key="MdOutline">#8E8E8E</Color>
            <Color x:Key="MdOutlineVariant">#494949</Color>
            <Color x:Key="MdError">#F2B8B5</Color>
            <Color x:Key="MdErrorContainer">#8C1D18</Color>
            <Color x:Key="MdOnErrorContainer">#F9DEDC</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource MdPrimary}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{ThemeResource MdOnPrimary}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{ThemeResource MdPrimaryContainer}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{ThemeResource MdOnPrimaryContainer}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{ThemeResource MdSecondaryContainer}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{ThemeResource MdOnSecondaryContainer}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{ThemeResource MdTertiaryContainer}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{ThemeResource MdOnTertiaryContainer}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource MdSurface}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{ThemeResource MdOnSurface}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{ThemeResource MdSurfaceContainer}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{ThemeResource MdSurfaceContainerHigh}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{ThemeResource MdOnSurfaceVariant}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{ThemeResource MdOutline}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{ThemeResource MdOutlineVariant}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource MdError}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{ThemeResource MdErrorContainer}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{ThemeResource MdOnErrorContainer}" />

    <!-- Frosted-glass surface (in-app acrylic). ThemeSyncService retints TintColor/
         FallbackColor alongside the solid brushes so the frost follows the phone. -->
    <AcrylicBrush
        x:Key="FrostedSurfaceBrush"
        TintColor="{ThemeResource MdSurfaceContainer}"
        FallbackColor="{ThemeResource MdSurfaceContainer}"
        TintOpacity="0.55"
        TintLuminosityOpacity="0.6" />

    <!-- Scrim laid over the phone wallpaper in the Home widgets section so content stays
         legible: a "whitey fog" in light theme, a "shadow" in dark. ThemeSyncService
         retints it toward the wallpaper's most-abundant colour (M10 polish). -->
    <SolidColorBrush x:Key="WallpaperScrimBrush" Color="#CC101010" />

    <!-- Expressive shape scale: pill buttons, extra-large cards -->
    <CornerRadius x:Key="ShapeFull">24</CornerRadius>
    <CornerRadius x:Key="ShapeExtraLarge">28</CornerRadius>
    <CornerRadius x:Key="ShapeLarge">16</CornerRadius>

    <Style x:Key="FilledButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShapeFull}" />
        <Setter Property="Padding" Value="28,14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="TonalButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnSecondaryContainerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShapeFull}" />
        <Setter Property="Padding" Value="28,14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ExpressiveCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceContainerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShapeExtraLarge}" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <!-- ExpressiveCard over frosted glass — for cards floating on imagery (Home rail). -->
    <Style x:Key="FrostedCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FrostedSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShapeExtraLarge}" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <Style x:Key="ExpressiveTextBox" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ShapeLarge}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="45" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        M18 A1: the two rungs the scale was missing. The desktop had Display 45 / Headline 28 /
        Title 18 / Body 15 and then nothing, so every caption and every widget label was a
        hand-set number - 10, 11, 12, 13 and 14 all appeared. The scale is now
        45 / 28 / 18 / 15 / 13 / 11, and the off-scale sizes were snapped to the nearest rung
        (10 to 11, 12 to 13, 14 to 15, 20 to 18, 24 to 28). The rung values are the ones already
        dominant in the tree, so the snap is close to visually neutral.

        These mirror the phone's labelSmall / bodySmall, so a caption reads the same on both.
    -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    </Style>
</ResourceDictionary>
