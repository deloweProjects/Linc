<Project>
  <!--
    M12 (beta packaging). Produces a self-contained folder that runs from a copy — bundles the
    .NET 8 + Windows App SDK runtime (SelfContained=true; WindowsAppSDKSelfContained is already
    project-wide in Linc.Desktop.csproj) alongside the app's own Content items (Assets\, the
    injected companion.apk, SCRCPY\Linc.scrcpy\bin\**\* — scrcpy + adb + the ~98 mingw64 DLLs).
    No installer, no MSIX, no signing — B2.5 keeps this to a zippable folder.

    Run with VS MSBuild x64 (not `dotnet publish` — this is a WinUI project):
      & "C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\amd64\MSBuild.exe" `
        DESKTOP\Linc.Desktop\Linc.Desktop.csproj -t:Publish -p:PublishProfile=Beta `
        -p:Configuration=Release -p:Platform=x64

    Output lands at DESKTOP\Linc.Desktop\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish\
    — zip that folder and copy it anywhere; it needs no .NET/Windows App SDK preinstalled.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!--
    M12b Part B. ROOT CAUSE of the silent no-window failure on a clean second PC: $(TargetName).pri
    — the app's OWN compiled
    resource index (every ThemeResource in Themes\MaterialExpressive.xaml: PrimaryContainerBrush
    and friends) — lands next to the exe for a normal Build (bin\...\win-x64\Linc.Desktop.pri
    exists), but the Publish target's file list never picks it up: Microsoft.UI.pri and
    Microsoft.UI.Xaml.Controls.pri arrive via the WindowsAppSDK NuGet package's own Content items
    (which set CopyToPublishDirectory), but the app's own .pri is generated at build time with no
    such item, so ComputeResolvedFilesToPublishList never sees it — because that hookup normally
    only exists on the MSIX packaging path, and this project is WindowsPackageType=None.
    Confirmed on THIS machine, no second PC needed: `Application.Current.Resources["PrimaryContainerBrush"]`
    throws COMException("Cannot find a resource with the given key") from HomeViewModel's
    constructor (via ThemeSyncService.BrushColor), deterministically, 3/3 runs of the unmodified
    publish output — every single launch, not a race. Before M12b Part A this exception was fully
    unhandled: no window, no dialog, no log, exactly what the owner saw.
  -->
  <Target Name="IncludeAppPriInPublishOutput" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri" Condition="Exists('$(TargetDir)$(TargetName).pri')">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    M12c Part B. The owner's second PC only launched after installing the VC++ redistributable
    AND taking the M12b .pri fix at the same time, so neither change is cleanly attributable —
    M12b's dumpbin analysis found nothing in the 647 published files importing msvcp140.dll or
    vcruntime140.dll, which is real evidence against needing this. The owner asked directly for
    the DLLs to ship anyway: ~1.5 MB against an already-25 MB bundled APK, and it removes a whole
    class of "works on my machine" regardless of which theory was right.

    Copied from the installed VS redist at publish time, NOT vendored into the repo (Microsoft
    binaries in source control is a licensing/hygiene problem this project does not need). The
    toolset version folder under VC\Redist\MSVC\ is NOT hardcoded — this machine's VS 18 install
    uses Microsoft.VC145.CRT (not the VC143 the task described as an example; toolset numbers
    move with VS versions), so the glob below matches Microsoft.VC1*.CRT under any version
    folder rather than a specific one.

    msvcp140.dll, vcruntime140.dll and vcruntime140_1.dll are REQUIRED — B2.4 fails the publish
    loudly (not silently) if the redist source folder is missing or incomplete, naming the exact
    directory searched. msvcp140_1.dll and msvcp140_2.dll ship only if present (glob Include
    against a real filesystem path only ever returns files that exist, so "if present" needs no
    extra Condition). vcruntime140_cor3.dll is .NET's own and is deliberately never touched here.
  -->
  <Target Name="IncludeVcRedistDllsInPublishOutput" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_VcRedistBase>C:\Program Files\Microsoft Visual Studio\18\Community\VC\Redist\MSVC</_VcRedistBase>
    </PropertyGroup>
    <ItemGroup>
      <_VcRedistRequiredDll Include="$(_VcRedistBase)\*\x64\Microsoft.VC1*.CRT\msvcp140.dll" />
      <_VcRedistRequiredDll Include="$(_VcRedistBase)\*\x64\Microsoft.VC1*.CRT\vcruntime140.dll" />
      <_VcRedistRequiredDll Include="$(_VcRedistBase)\*\x64\Microsoft.VC1*.CRT\vcruntime140_1.dll" />
      <_VcRedistOptionalDll Include="$(_VcRedistBase)\*\x64\Microsoft.VC1*.CRT\msvcp140_1.dll" />
      <_VcRedistOptionalDll Include="$(_VcRedistBase)\*\x64\Microsoft.VC1*.CRT\msvcp140_2.dll" />
    </ItemGroup>
    <Error
      Condition="'@(_VcRedistRequiredDll->Count())' != '3'"
      Text="Linc's publish couldn't find the Visual C++ redistributable DLLs it needs to bundle (msvcp140.dll, vcruntime140.dll, vcruntime140_1.dll — found @(_VcRedistRequiredDll->Count()) of 3). Looked in: $(_VcRedistBase)\&lt;version&gt;\x64\Microsoft.VC1*.CRT\. Install Visual Studio's 'Desktop development with C++' workload, or check this path if VS was reinstalled or the toolset version changed." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_VcRedistRequiredDll);@(_VcRedistOptionalDll)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
