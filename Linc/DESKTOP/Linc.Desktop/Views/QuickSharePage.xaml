<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.QuickSharePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:views="using:Linc.Desktop.Views">

    <ScrollViewer>
        <StackPanel views:PageLayout.Adaptive="True" Padding="32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="Share" Style="{StaticResource HeadlineText}" />
                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" TextWrapping="Wrap" Opacity="0.8"
                           Text="Send files and links to your phone. Linc uses its own link when the phone is connected, and Quick Share when it isn't — or for anyone else's device." />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind Linc.HasMessage, Mode=TwoWay}" Severity="Informational" Message="{x:Bind Linc.Message, Mode=OneWay}" />

            <!-- Send to your phone (Linc first, Quick Share when it isn't connected). -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource PrimaryBrush}"
                                 Visibility="{x:Bind Linc.OverLinc, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Linc.ModeText, Mode=OneWay}" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock views:Explain.IsHelp="True" Text="{x:Bind Linc.ModeHint, Mode=OneWay}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" Opacity="0.8" />
                    <Border AllowDrop="True" DragOver="OnPhoneDragOver" Drop="OnPhoneDrop" MinHeight="96" CornerRadius="16"
                            BorderThickness="2" BorderBrush="{ThemeResource OutlineVariantBrush}" Background="{ThemeResource SurfaceContainerBrush}"
                            AutomationProperties.Name="Drop files here to send them to your phone">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="16">
                            <FontIcon Glyph="&#xE898;" FontSize="24" Opacity="0.7" />
                            <TextBlock Text="Drop files here" HorizontalAlignment="Center" />
                            <Button HorizontalAlignment="Center" Style="{StaticResource FilledButton}" Click="OnSendToPhoneClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Choose files…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="A link opens on the phone; text lands on its clipboard"
                                 Text="{x:Bind Linc.TextToPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Text or a link to send to the phone" />
                        <Button Grid.Column="1" Content="Send" IsEnabled="{x:Bind Linc.CanSendText, Mode=OneWay}"
                                Command="{x:Bind Linc.SendTextCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Files going to the phone over Linc -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20" Visibility="{x:Bind Linc.HasTransfers, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sent to your phone" Style="{StaticResource TitleText}" />
                    <ItemsControl ItemsSource="{x:Bind Linc.Transfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhoneTransferVm">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Opacity="0.8" />
                                        <ProgressBar Value="{x:Bind Progress}" Visibility="{x:Bind IsSending}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Retry" Visibility="{x:Bind IsFailed}" Command="{x:Bind RetryCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Files from the phone -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Received from your phone" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Content="Open folder" Command="{x:Bind Linc.OpenReceivedFolderCommand}" />
                    </Grid>
                    <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" Opacity="0.8" TextWrapping="Wrap"
                               Text="Files shared to &quot;Linc — send to PC&quot; on the phone land here (Pictures\Linc\Shared)."
                               Visibility="{x:Bind Linc.NoReceived, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Linc.Received}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReceivedVm">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionText}" Opacity="0.7" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open" Command="{x:Bind OpenCommand}" />
                                    <Button Grid.Column="2" Content="Show in folder" Command="{x:Bind ShowInFolderCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="Quick Share" Style="{StaticResource HeadlineText}" FontSize="24" />
                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" TextWrapping="Wrap" Opacity="0.8"
                           Text="Any Android phone nearby, including yours when Linc isn't connected. No Linc app needed on theirs; same Wi-Fi network." />
            </StackPanel>

            <!-- Visibility -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Receive with Quick Share" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{x:Bind ViewModel.VisibilityText, Mode=OneWay}"
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="Visible" OffContent="Hidden"
                                  IsOn="{x:Bind ViewModel.ReceiveEnabled, Mode=TwoWay}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Name phones see" Width="260"
                                 Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Save name" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SaveNameCommand}" />
                        <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.OpenReceivedFolderCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ReceivedFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="Received files" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Files handed over from Explorer's "Send with Quick Share" -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasQueuedFiles, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     Title="Quick Share" Message="{x:Bind ViewModel.QueuedText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Send" Style="{StaticResource FilledButton}"
                            IsEnabled="{x:Bind ViewModel.CanSendQueued, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SendQueuedCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Button Content="Clear" Margin="0,0,0,12" Command="{x:Bind ViewModel.ClearQueuedCommand}" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Send -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Send to a nearby device" Style="{StaticResource TitleText}" />
                            <TextBlock Text="{x:Bind ViewModel.NearbyHint, Mode=OneWay}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ScanCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="16" Height="16" />
                                <TextBlock Text="Scan" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource FilledButton}"
                                IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}" Click="OnSendClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE724;" FontSize="14" />
                                <TextBlock Text="Choose files…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <GridView ItemsSource="{x:Bind ViewModel.Nearby}" SelectionMode="Single"
                              SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                              AllowDrop="True" DragOver="OnDeviceDragOver" Drop="OnDeviceDrop">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QsNearbyVm">
                                <StackPanel Width="140" Padding="8" Spacing="6">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="32" />
                                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Text or a link to send to the selected device"
                                 Text="{x:Bind ViewModel.TextToSend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Paste" Command="{x:Bind ViewModel.PasteClipboardCommand}"
                                ToolTipService.ToolTip="Paste what's on this PC's clipboard" />
                        <Button Grid.Column="2" Content="Send text" IsEnabled="{x:Bind ViewModel.CanSendText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SendTextCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Options -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Options" Style="{StaticResource TitleText}" />
                    <ToggleSwitch Header="Accept from my connected phone without asking"
                                  IsOn="{x:Bind ViewModel.AutoAcceptOwnPhone, Mode=TwoWay}" />
                    <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Opacity="0.8"
                               Text="Only when Linc is connected to that phone over Wi-Fi and the Quick Share comes from the same network address with the same name. A name alone is never trusted, and a USB link can't be checked this way." />
                    <ToggleSwitch Header="Show &quot;Send to phone (Linc)&quot; and &quot;Send with Quick Share&quot; when right-clicking files in Explorer, and Linc in its Send to list"
                                  IsOn="{x:Bind ViewModel.ExplorerMenuEnabled, Mode=TwoWay}" />
                    <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Opacity="0.8"
                               Text="On Windows 11 it appears under Show more options. Only for your account; turning this off removes it." />
                    <TextBlock Text="{x:Bind ViewModel.ShellError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Transfers -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20"
                    Visibility="{x:Bind ViewModel.HasTransfers, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Transfers" Style="{StaticResource TitleText}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Transfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QsTransferVm">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Headline}" Style="{StaticResource CaptionText}" Opacity="0.7" />
                                        <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        <ProgressBar Value="{x:Bind Progress}" Visibility="{x:Bind ShowProgress}" />
                                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ShowWaiting}" />
                                        <TextBlock Text="{x:Bind ReceivedText}" Visibility="{x:Bind HasText}" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" Opacity="0.9" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="Open" Visibility="{x:Bind CanOpen}" Command="{x:Bind OpenCommand}" />
                                        <Button Content="Open link" Visibility="{x:Bind HasLink}" Command="{x:Bind OpenLinkCommand}" />
                                        <Button Content="Copy" Visibility="{x:Bind HasText}" Command="{x:Bind CopyTextCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
