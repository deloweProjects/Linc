<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels">

    <ScrollViewer
        VerticalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- USB device detected, needs confirmation. Top-level and NOT inside the disconnected
             panel (M15c A1): a second phone plugged in while one is live is precisely when the
             user must be offered the choice, and that is the case the old placement hid. -->
        <Border
            Style="{StaticResource ExpressiveCard}"
            MaxWidth="520"
            HorizontalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowUsbDeviceDetected, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="Phone detected over USB" Style="{StaticResource TitleText}" />
                <TextBlock Text="{x:Bind ViewModel.UsbDeviceText, Mode=OneWay}" Style="{StaticResource BodyText}" />
                <TextBlock
                    Style="{StaticResource BodyText}"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.UsbDeviceMessage, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Style="{StaticResource FilledButton}"
                        Content="{x:Bind ViewModel.UsbPrimaryActionText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConnectUsbCommand}" />
                    <Button
                        Style="{StaticResource TonalButton}"
                        Content="Cancel"
                        Command="{x:Bind ViewModel.DismissUsbDeviceCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Disconnected panels -->
        <StackPanel
            Grid.Row="1"
            Spacing="16"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.ShowDisconnectedArea, Mode=OneWay}">

            <!-- Searching for the paired phone -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Visibility="{x:Bind ViewModel.ShowSearching, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="True" Width="24" Height="24" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SearchingText, Mode=OneWay}"
                            Style="{StaticResource TitleText}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="Linc connects automatically when the phone is on the same Wi-Fi network with Wireless debugging on, or over USB." />
                    <Button
                        Style="{StaticResource TonalButton}"
                        Content="Pair a different phone"
                        Command="{x:Bind ViewModel.StartPairingCommand}" />
                </StackPanel>
            </Border>

            <!-- First run: nothing paired yet -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Visibility="{x:Bind ViewModel.ShowGetStarted, Mode=OneWay}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Link your phone" Style="{StaticResource HeadlineText}" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="Pair once, and from then on Linc will find and connect to your phone by itself whenever you're on the same Wi-Fi or plugged in over USB." />
                    <Button
                        Style="{StaticResource FilledButton}"
                        Content="Pair phone"
                        Command="{x:Bind ViewModel.StartPairingCommand}" />
                </StackPanel>
            </Border>

            <!-- Paused after a manual disconnect -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Visibility="{x:Bind ViewModel.ShowPaused, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Disconnected" Style="{StaticResource TitleText}" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="Automatic connection is paused. Resume to let Linc find your phone again." />
                    <Button
                        Style="{StaticResource FilledButton}"
                        Content="Resume"
                        Command="{x:Bind ViewModel.ResumeCommand}" />
                </StackPanel>
            </Border>

            <!-- Pairing flow -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Visibility="{x:Bind ViewModel.ShowPairing, Mode=OneWay}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Pair your phone" Style="{StaticResource HeadlineText}" />
                    <!-- M15c A2: say the one-phone limit before the collision, not after it. -->
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowOneAtATimeNote, Mode=OneWay}"
                        Text="{x:Bind ViewModel.OneAtATimeText, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="On the phone: Settings → Developer options → Wireless debugging → “Pair device with QR code”, then scan this:" />
                    <Border
                        Background="White"
                        CornerRadius="{StaticResource ShapeLarge}"
                        Padding="16"
                        HorizontalAlignment="Left">
                        <Image
                            Source="{x:Bind ViewModel.QrImage, Mode=OneWay}"
                            Width="200"
                            Height="200" />
                    </Border>
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="Prefer typing? Choose “Pair device with pairing code” on the phone instead, and enter the 6-digit code here:" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="{x:Bind ViewModel.PairingPhoneText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox
                            Style="{StaticResource ExpressiveTextBox}"
                            Width="160"
                            PlaceholderText="6-digit code"
                            Text="{x:Bind ViewModel.PairingCode, Mode=TwoWay}" />
                        <Button
                            Style="{StaticResource FilledButton}"
                            Content="Pair"
                            Command="{x:Bind ViewModel.PairWithCodeCommand}"
                            IsEnabled="{x:Bind ViewModel.CanPairWithCode, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Style="{StaticResource TonalButton}"
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelPairingCommand}" />
                </StackPanel>
            </Border>

            <!-- Connection method (per device) -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Visibility="{x:Bind ViewModel.ShowConnectionMethod, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Connection method" Style="{StaticResource TitleText}" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="Automatic picks the best link available and switches as things change (USB is preferred, then Wireless debugging, then a direct Wi-Fi connection)." />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ConnectionMethods}"
                        SelectedItem="{x:Bind ViewModel.SelectedConnectionMethod, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
                </StackPanel>
            </Border>

            <!-- Manual fallback -->
            <Expander Header="Advanced: connect by address" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Text="Type the IP address &amp; port from the phone's Wireless debugging screen." />
                    <TextBox
                        Style="{StaticResource ExpressiveTextBox}"
                        PlaceholderText="192.168.1.23:37099"
                        Text="{x:Bind ViewModel.HostPort, Mode=TwoWay}" />
                    <Button
                        Style="{StaticResource TonalButton}"
                        Content="Connect"
                        Command="{x:Bind ViewModel.ConnectCommand}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                </StackPanel>
            </Expander>

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Connected: device summary + embedded Mirror panel -->
        <StackPanel
            Grid.Row="1"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ShowConnectedArea, Mode=OneWay}">

            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{x:Bind ViewModel.DeviceModel, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.DeviceSerial, Mode=OneWay}"
                                Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Battery" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Storage" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StorageText, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Protocol" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ProtocolVersion, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <Button
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource TonalButton}"
                            Content="Disconnect"
                            Command="{x:Bind ViewModel.DisconnectCommand}" />
                    </Grid>

                    <!-- Connection health -->
                    <Grid Grid.Row="1" ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Connected for" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ConnectedDurationText, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Reconnects" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ReconnectCount, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Link" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TransportText, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TransportChoiceText, Mode=OneWay}"
                                Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Latency" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}"
                                Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="2" Visibility="{x:Bind ViewModel.HasLastError, Mode=OneWay}">
                            <TextBlock Text="Last issue" Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.LastErrorMessage, Mode=OneWay}"
                                Style="{StaticResource BodyText}"
                                Foreground="{ThemeResource ErrorBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Connection method (per device) -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Connection method"
                        Style="{StaticResource TitleText}"
                        VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.ConnectionMethods}"
                        SelectedItem="{x:Bind ViewModel.SelectedConnectionMethod, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyText}"
                        TextWrapping="Wrap"
                        Text="Automatic switches to the best available link (USB &gt; Wireless &gt; Direct Wi-Fi)." />
                </Grid>
            </Border>

            <!-- Use this link now (M15a Part C): a one-off override, not the sticky preference
                 above. Dropped automatically, with a message, if the link it picks dies. -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Padding="20,16"
                Visibility="{x:Bind ViewModel.ShowTransportOverride, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Use this link now" Style="{StaticResource TitleText}" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        TextWrapping="Wrap"
                        Text="Pick a link instead of waiting for Linc to decide. It stays pinned until you clear it or that link stops answering." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Use wireless now"
                            Command="{x:Bind ViewModel.UseWirelessNowCommand}"
                            IsEnabled="{x:Bind ViewModel.CanUseWirelessNow, Mode=OneWay}" />
                        <Button
                            Content="Use USB now"
                            Command="{x:Bind ViewModel.UseUsbNowCommand}"
                            IsEnabled="{x:Bind ViewModel.CanUseUsbNow, Mode=OneWay}" />
                        <Button
                            Content="Back to automatic"
                            Command="{x:Bind ViewModel.UseAutomaticTransportCommand}"
                            IsEnabled="{x:Bind ViewModel.HasManualTransport, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tools: device tooling gathered in one card -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Tools" Style="{StaticResource TitleText}" />

                    <!-- Tools › Screen mirroring -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Screen mirroring" Style="{StaticResource TitleText}" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        Width="240"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind Mirror.Presets}"
                        SelectedItem="{x:Bind Mirror.SelectedPreset, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource FilledButton}"
                        Content="{x:Bind Mirror.ButtonText, Mode=OneWay}"
                        Command="{x:Bind Mirror.ToggleCommand}"
                        IsEnabled="{x:Bind Mirror.CanMirror, Mode=OneWay}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Text="{x:Bind Mirror.StatusText, Mode=OneWay}"
                            Style="{StaticResource BodyText}" />
                        <TextBlock
                            Text="{x:Bind Mirror.ErrorMessage, Mode=OneWay}"
                            Foreground="{ThemeResource ErrorBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Mirror.HasError, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                        <!-- Mirror settings (collapsed by default; applies to the NEXT start) -->
                        <Expander
                            Header="Mirror settings"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                            <StackPanel Spacing="12" Padding="0,12,0,0">
                                <TextBlock
                                    Style="{StaticResource BodyText}"
                                    TextWrapping="Wrap"
                                    Text="These apply the next time you start mirroring, not to a session already running." />

                                <!-- Max size + bit rate -->
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Max size"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="4096"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind MirrorSettings.MaxSize, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="Video bit rate"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="3"
                                        Style="{StaticResource ExpressiveTextBox}"
                                        PlaceholderText="8M"
                                        Text="{x:Bind MirrorSettings.VideoBitRate, Mode=TwoWay}" />
                                </Grid>

                                <!-- Max FPS + Crop -->
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Max FPS"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="120"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind MirrorSettings.MaxFps, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="Crop"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="3"
                                        Style="{StaticResource ExpressiveTextBox}"
                                        PlaceholderText="1280x720:0:0"
                                        Text="{x:Bind MirrorSettings.Crop, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource BodyText}"
                                    TextWrapping="Wrap"
                                    Text="Set Max size, Max FPS or Crop to 0 (or leave Crop blank) to use the default." />

                                <!-- Booleans -->
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch
                                        Header="Stay awake"
                                        IsOn="{x:Bind MirrorSettings.StayAwake, Mode=TwoWay}" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        Header="Turn screen off"
                                        IsOn="{x:Bind MirrorSettings.TurnScreenOff, Mode=TwoWay}" />
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        Header="Show touches"
                                        IsOn="{x:Bind MirrorSettings.ShowTouches, Mode=TwoWay}" />
                                </Grid>

                                <!-- Audio -->
                                <ToggleSwitch
                                    Header="Audio"
                                    IsOn="{x:Bind MirrorSettings.AudioEnabled, Mode=TwoWay}" />
                                <TextBlock
                                    Style="{StaticResource BodyText}"
                                    TextWrapping="Wrap"
                                    Text="Audio plays through the PC while mirroring, and the phone stays silent. Turn this off to keep audio on the phone instead." />
                                <Grid
                                    ColumnSpacing="16"
                                    RowSpacing="8"
                                    Visibility="{x:Bind MirrorSettings.AudioEnabled, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Audio source"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind MirrorSettings.AudioSources}"
                                        SelectedItem="{x:Bind MirrorSettings.AudioSource, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="Audio bit rate"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center" />
                                    <NumberBox
                                        Grid.Column="3"
                                        Minimum="0"
                                        Maximum="512000"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind MirrorSettings.AudioBitRate, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind MirrorSettings.AudioConflictWarning, Mode=OneWay}"
                                    Foreground="{ThemeResource ErrorBrush}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource BodyText}"
                                    Visibility="{x:Bind MirrorSettings.HasAudioConflictWarning, Mode=OneWay}" />

                                <!-- Validation / status messages -->
                                <TextBlock
                                    Text="{x:Bind MirrorSettings.ValidationMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource ErrorBrush}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource BodyText}"
                                    Visibility="{x:Bind MirrorSettings.HasValidationMessage, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind MirrorSettings.StatusMessage, Mode=OneWay}"
                                    Style="{StaticResource BodyText}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind MirrorSettings.HasStatusMessage, Mode=OneWay}" />

                                <!-- Save + Reset -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        Style="{StaticResource FilledButton}"
                                        Content="Save"
                                        Command="{x:Bind MirrorSettings.SaveCommand}"
                                        IsEnabled="{x:Bind MirrorSettings.IsDirty, Mode=OneWay}" />
                                    <Button
                                        Style="{StaticResource TonalButton}"
                                        Content="Reset to defaults"
                                        Command="{x:Bind MirrorSettings.ResetCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" Opacity="0.5" />

                    <!-- Tools › Desktop Mode -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Desktop Mode" Style="{StaticResource TitleText}" />
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" MaxWidth="280">
                            <Button
                                Style="{StaticResource FilledButton}"
                                Content="{x:Bind DesktopMode.ButtonText, Mode=OneWay}"
                                Command="{x:Bind DesktopMode.ToggleCommand}"
                                IsEnabled="{x:Bind DesktopMode.CanStart, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap"
                                Text="Desktop Mode opens a second screen for your phone — a separate display you can run apps on. Apps run fullscreen on it because this phone doesn't support Android's freeform windows." />
                            <TextBlock
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap"
                                Text="Your mouse is captured by the phone while Desktop Mode is running. Press Alt or Super to get your cursor back." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{x:Bind DesktopMode.StatusText, Mode=OneWay}"
                                Style="{StaticResource BodyText}" />
                            <TextBlock
                                Text="{x:Bind DesktopMode.ErrorMessage, Mode=OneWay}"
                                Foreground="{ThemeResource ErrorBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind DesktopMode.HasError, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind DesktopMode.IsSetupPending, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind DesktopMode.SetupMessage, Mode=OneWay}"
                            Style="{StaticResource BodyText}"
                            VerticalAlignment="Center" />
                        <Button
                            Style="{StaticResource TonalButton}"
                            Content="Reboot now"
                            Command="{x:Bind DesktopMode.RebootCommand}" />
                    </StackPanel>

                    <!-- Desktop Mode settings (collapsed by default; applies to the NEXT launch) -->
                    <Expander
                        Grid.Row="2"
                        Header="Desktop Mode settings"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="False">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <TextBlock
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap"
                                Text="These apply the next time Desktop Mode starts, not to a session already running." />

                            <!-- Resolution + DPI -->
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="Width"
                                    Style="{StaticResource BodyText}"
                                    VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="3840"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind DesktopModeSettings.Width, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="Height"
                                    Style="{StaticResource BodyText}"
                                    VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="3"
                                    Minimum="0"
                                    Maximum="3840"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind DesktopModeSettings.Height, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="DPI"
                                    Style="{StaticResource BodyText}"
                                    VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="5"
                                    Minimum="0"
                                    Maximum="320"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind DesktopModeSettings.Dpi, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap"
                                Text="Set width, height and DPI to 0 each to let Linc compute a recommended value from your phone." />

                            <!-- Aspect ratio mode -->
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="Aspect ratio"
                                    Style="{StaticResource BodyText}"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind DesktopModeSettings.AspectModes}"
                                    SelectedItem="{x:Bind DesktopModeSettings.AspectMode, Mode=TwoWay}" />
                            </Grid>

                            <!-- Booleans -->
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    Header="Capture mouse"
                                    IsOn="{x:Bind DesktopModeSettings.CaptureMouse, Mode=TwoWay}" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    Header="Forward audio"
                                    IsOn="{x:Bind DesktopModeSettings.ForwardAudio, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap"
                                Text="Audio is off by default in Desktop Mode — decoding it costs performance on the second screen. Turn it on if you need sound there." />
                            <TextBlock
                                Text="{x:Bind DesktopModeSettings.AudioConflictWarning, Mode=OneWay}"
                                Foreground="{ThemeResource ErrorBrush}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyText}"
                                Visibility="{x:Bind DesktopModeSettings.HasAudioConflictWarning, Mode=OneWay}" />

                            <!-- Max FPS + bit rate -->
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="Max FPS"
                                    Style="{StaticResource BodyText}"
                                    VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="120"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind DesktopModeSettings.MaxFps, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="Video bit rate"
                                    Style="{StaticResource BodyText}"
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Grid.Column="3"
                                    Style="{StaticResource ExpressiveTextBox}"
                                    PlaceholderText="8M"
                                    Text="{x:Bind DesktopModeSettings.VideoBitRate, Mode=TwoWay}" />
                            </Grid>

                            <!-- Validation / status messages -->
                            <TextBlock
                                Text="{x:Bind DesktopModeSettings.ValidationMessage, Mode=OneWay}"
                                Foreground="{ThemeResource ErrorBrush}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyText}"
                                Visibility="{x:Bind DesktopModeSettings.HasValidationMessage, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind DesktopModeSettings.StatusMessage, Mode=OneWay}"
                                Style="{StaticResource BodyText}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind DesktopModeSettings.HasStatusMessage, Mode=OneWay}" />

                            <!-- Save + Reset to recommended -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    Style="{StaticResource FilledButton}"
                                    Content="Save"
                                    Command="{x:Bind DesktopModeSettings.SaveCommand}"
                                    IsEnabled="{x:Bind DesktopModeSettings.IsDirty, Mode=OneWay}" />
                                <Button
                                    Style="{StaticResource TonalButton}"
                                    Content="Reset to recommended"
                                    Command="{x:Bind DesktopModeSettings.ResetToRecommendedCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" Opacity="0.5" />

                    <!-- Tools › Display (M5c-2 / D-055): rotation picker + brightness auto + 0–100 slider -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Display" Style="{StaticResource TitleText}" />
                        <TextBlock
                            Style="{StaticResource BodyText}"
                            TextWrapping="Wrap"
                            Text="Force the phone's screen orientation and brightness from here. Changes apply on the phone through its system settings; the phone needs the 'Modify system settings' permission (an appop — granted in Settings, not a dialog)." />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Text="Rotation"
                                Style="{StaticResource BodyText}"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind DisplayControl.RotationOptions}"
                                SelectedItem="{x:Bind DisplayControl.RotationMode, Mode=OneWay}"
                                IsEnabled="{x:Bind DisplayControl.CanChangeRotation, Mode=OneWay}"
                                PlaceholderText="Unknown"
                                SelectionChanged="RotationCombo_SelectionChanged" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource BodyText}"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayControl.RotationStatusText, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="1"
                                Text="Adaptive brightness"
                                Style="{StaticResource BodyText}"
                                VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OnContent="On"
                                OffContent="Off"
                                IsOn="{x:Bind DisplayControl.BrightnessAutoToggleOn, Mode=OneWay}"
                                IsEnabled="{x:Bind DisplayControl.CanChangeBrightness, Mode=OneWay}"
                                Toggled="BrightnessAutoToggle_Toggled" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource BodyText}"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayControl.BrightnessAutoStatusText, Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Brightness"
                                Style="{StaticResource BodyText}"
                                VerticalAlignment="Center" />
                            <Slider
                                x:Name="BrightnessSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                SmallChange="1"
                                Value="{x:Bind DisplayControl.BrightnessLevelSlider, Mode=OneWay}"
                                IsEnabled="{x:Bind DisplayControl.IsBrightnessSliderEnabled, Mode=OneWay}"
                                ValueChanged="BrightnessSlider_ValueChanged"
                                HorizontalAlignment="Stretch" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource BodyText}"
                                VerticalAlignment="Center"
                                MinWidth="80"
                                Text="{x:Bind DisplayControl.BrightnessLevelStatusText, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            Style="{StaticResource BodyText}"
                            TextWrapping="Wrap"
                            Text="{x:Bind DisplayControl.StatusText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource BodyText}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource ErrorBrush}"
                            Text="{x:Bind DisplayControl.ErrorMessage, Mode=OneWay}"
                            Visibility="{x:Bind DisplayControl.HasError, Mode=OneWay}" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" Opacity="0.5" />

                    <!-- Tools › Install app (M10 Part A): push an arbitrary local .apk to the phone -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Install app" Style="{StaticResource TitleText}" />
                        <TextBlock
                            Style="{StaticResource BodyText}"
                            TextWrapping="Wrap"
                            Text="Check your phone — it may ask you to allow the install." />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Style="{StaticResource FilledButton}"
                                Content="Install app…"
                                Command="{x:Bind ViewModel.InstallApkCommand}"
                                IsEnabled="{x:Bind ViewModel.CanInstallApk, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ApkInstallStatusText, Mode=OneWay}"
                                    Style="{StaticResource BodyText}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ApkInstallErrorMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource ErrorBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasApkInstallError, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
