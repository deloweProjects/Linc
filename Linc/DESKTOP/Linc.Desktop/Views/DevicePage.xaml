<?xml version="1.0" encoding="utf-8"?>
<!--
    The phone's page (D-097 redesign). Connected, it reads top to bottom by how often each thing
    is used: who is connected and how it's doing (hero + stat tiles), the phone's controls
    (media, sound, find, Do Not Disturb, screenshot, display), its screen on this PC (mirror,
    Desktop Mode), then the rarer things (installing an app, how the link is made). Two columns on
    a wide window, one on a narrow one. Explanatory lines are marked views:Explain.IsHelp, so
    Settings → Show explanations hides them; values, warnings and errors always show.
-->
<Page
    x:Class="Linc.Desktop.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:vm="using:Linc.Desktop.ViewModels">

    <ScrollViewer
        VerticalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <!-- Adaptive triggers only run on the page's root element, so they live here, not on the grid. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumn.(Grid.Column)" Value="0" />
                        <Setter Target="RightColumn.(Grid.Row)" Value="1" />
                        <Setter Target="SecondColumn.Width" Value="0" />
                        <Setter Target="Columns.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="Root" views:PageLayout.Adaptive="True" Padding="32" RowSpacing="20" MaxWidth="1280">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- USB device detected, needs confirmation. Top-level and NOT inside the disconnected
                 panel (M15c A1): a second phone plugged in while one is live is precisely when the
                 user must be offered the choice, and that is the case the old placement hid. -->
            <Border
                Style="{StaticResource HeroCard}"
                MaxWidth="560"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.ShowUsbDeviceDetected, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Phone detected over USB" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{x:Bind ViewModel.UsbDeviceText, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{x:Bind ViewModel.UsbDeviceMessage, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource FilledButton}" Content="{x:Bind ViewModel.UsbPrimaryActionText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ConnectUsbCommand}" />
                        <Button Style="{StaticResource QuietButton}" Content="Cancel" Command="{x:Bind ViewModel.DismissUsbDeviceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= Not connected ================= -->
            <StackPanel
                Grid.Row="1"
                Spacing="16"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.ShowDisconnectedArea, Mode=OneWay}">

                <!-- Searching for the paired phone -->
                <Border Style="{StaticResource HeroCard}" Visibility="{x:Bind ViewModel.ShowSearching, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ProgressRing IsActive="True" Width="28" Height="28" />
                            <TextBlock Text="{x:Bind ViewModel.SearchingText, Mode=OneWay}" Style="{StaticResource TitleText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}"
                                   Text="Linc connects by itself when the phone is on the same Wi-Fi with Wireless debugging on, or plugged in over USB." />
                        <Button Style="{StaticResource QuietButton}" Content="Pair a different phone" Command="{x:Bind ViewModel.StartPairingCommand}" />
                    </StackPanel>
                </Border>

                <!-- First run: nothing paired yet -->
                <Border Style="{StaticResource HeroCard}" Visibility="{x:Bind ViewModel.ShowGetStarted, Mode=OneWay}">
                    <StackPanel Spacing="16">
                        <FontIcon Glyph="&#xE8EA;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                        <TextBlock Text="Link your phone" Style="{StaticResource HeadlineText}" />
                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}"
                                   Text="Pair once. After that Linc finds and connects to your phone by itself, on the same Wi-Fi or over USB." />
                        <Button Style="{StaticResource FilledButton}" Content="Pair phone" Command="{x:Bind ViewModel.StartPairingCommand}" />
                    </StackPanel>
                </Border>

                <!-- Paused after a manual disconnect -->
                <Border Style="{StaticResource ExpressiveCard}" Visibility="{x:Bind ViewModel.ShowPaused, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Disconnected" Style="{StaticResource TitleText}" />
                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" Text="Automatic connection is paused until you resume it." />
                        <Button Style="{StaticResource FilledButton}" Content="Resume" Command="{x:Bind ViewModel.ResumeCommand}" />
                    </StackPanel>
                </Border>

                <!-- Pairing flow -->
                <Border Style="{StaticResource ExpressiveCard}" Visibility="{x:Bind ViewModel.ShowPairing, Mode=OneWay}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Pair your phone" Style="{StaticResource HeadlineText}" />
                        <!-- M15c A2: say the one-phone limit before the collision, not after it. -->
                        <TextBlock Style="{StaticResource BodyText}" Visibility="{x:Bind ViewModel.ShowOneAtATimeNote, Mode=OneWay}" Text="{x:Bind ViewModel.OneAtATimeText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="On the phone: Settings → Developer options → Wireless debugging → “Pair device with QR code”, then scan this:" />
                        <Border Background="White" CornerRadius="{StaticResource ShapeLarge}" Padding="16" HorizontalAlignment="Left">
                            <Image Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Width="200" Height="200" />
                        </Border>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Or choose “Pair device with pairing code” on the phone and type the 6-digit code here:" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{x:Bind ViewModel.PairingPhoneText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox Style="{StaticResource ExpressiveTextBox}" Width="160" PlaceholderText="6-digit code" Text="{x:Bind ViewModel.PairingCode, Mode=TwoWay}" />
                            <Button Style="{StaticResource FilledButton}" Content="Pair" Command="{x:Bind ViewModel.PairWithCodeCommand}" IsEnabled="{x:Bind ViewModel.CanPairWithCode, Mode=OneWay}" />
                        </StackPanel>
                        <Button Style="{StaticResource QuietButton}" Content="Cancel" Command="{x:Bind ViewModel.CancelPairingCommand}" />
                    </StackPanel>
                </Border>

                <!-- Connection method (per device) -->
                <Border Style="{StaticResource ExpressiveCard}" Visibility="{x:Bind ViewModel.ShowConnectionMethod, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Connection method" Style="{StaticResource TitleText}" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ConnectionMethods}"
                                  SelectedItem="{x:Bind ViewModel.SelectedConnectionMethod, Mode=TwoWay}" DisplayMemberPath="Label" />
                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}"
                                   Text="Automatic picks the best link and switches as things change: USB, then Wireless debugging, then a direct Wi-Fi connection." />
                    </StackPanel>
                </Border>

                <!-- Manual fallback -->
                <Expander Header="Connect by address" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" Text="The IP address and port from the phone's Wireless debugging screen." />
                        <TextBox Style="{StaticResource ExpressiveTextBox}" PlaceholderText="192.168.1.23:37099" Text="{x:Bind ViewModel.HostPort, Mode=TwoWay}" />
                        <Button Style="{StaticResource TonalButton}" Content="Connect" Command="{x:Bind ViewModel.ConnectCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                    </StackPanel>
                </Expander>

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ================= Connected ================= -->
            <StackPanel Grid.Row="1" Spacing="20" Visibility="{x:Bind ViewModel.ShowConnectedArea, Mode=OneWay}">

                <!-- Hero: who, how, and the big actions -->
                <Border Style="{StaticResource HeroCard}">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource PrimaryBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EA;" FontSize="28" Foreground="{ThemeResource OnPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" Style="{StaticResource HeadlineText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource OnPrimaryContainerBrush}">
                                    <Run Text="{x:Bind ViewModel.TransportText, Mode=OneWay}" />
                                    <Run Text=" · connected for " />
                                    <Run Text="{x:Bind ViewModel.ConnectedDurationText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Style="{StaticResource FilledButton}" Command="{x:Bind Mirror.ToggleCommand}" IsEnabled="{x:Bind Mirror.CanMirror, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                                        <TextBlock Text="{x:Bind Mirror.ButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Stat tiles -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BATTERY" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatTile}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="STORAGE" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="LATENCY" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.LatencyText, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource StatTile}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="LINK" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.TransportChoiceText, Mode=OneWay}" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.LastErrorMessage, Mode=OneWay}" Style="{StaticResource BodyText}" Foreground="{ThemeResource ErrorBrush}"
                                   Visibility="{x:Bind ViewModel.HasLastError, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Two columns: controls on the left, screen and the rest on the right -->
                <Grid x:Name="Columns" ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: the phone's controls -->
                    <StackPanel Spacing="20">
                        <!-- Media -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="NOW PLAYING ON THE PHONE" Style="{StaticResource SectionLabel}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="72" Height="72">
                                        <Border CornerRadius="20" Background="{ThemeResource TertiaryContainerBrush}">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="26" Foreground="{ThemeResource OnTertiaryContainerBrush}" Visibility="{x:Bind Home.HasNoMediaArt, Mode=OneWay}" />
                                        </Border>
                                        <Border CornerRadius="20" Visibility="{x:Bind Home.HasMediaArt, Mode=OneWay}">
                                            <Image Source="{x:Bind Home.MediaArt, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Home.MediaTitle, Mode=OneWay}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Home.MediaSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconTonalButton}" Command="{x:Bind Home.PreviousTrackCommand}" IsEnabled="{x:Bind Home.HasMedia, Mode=OneWay}" ToolTipService.ToolTip="Previous">
                                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                                    </Button>
                                    <Button Width="64" Height="64" Padding="0" CornerRadius="32" BorderThickness="0" Background="{ThemeResource PrimaryBrush}"
                                            Command="{x:Bind Home.PlayPauseCommand}" IsEnabled="{x:Bind Home.HasMedia, Mode=OneWay}" ToolTipService.ToolTip="Play / pause">
                                        <FontIcon Glyph="{x:Bind Home.PlayPauseGlyph, Mode=OneWay}" FontSize="22" Foreground="{ThemeResource OnPrimaryBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource IconTonalButton}" Command="{x:Bind Home.NextTrackCommand}" IsEnabled="{x:Bind Home.HasMedia, Mode=OneWay}" ToolTipService.ToolTip="Next">
                                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick controls -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="PHONE CONTROLS" Style="{StaticResource SectionLabel}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource ActionTile}" Command="{x:Bind Home.RingPhoneCommand}" IsEnabled="{x:Bind Home.QuickActionsEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="Ring the phone at full volume (press again to stop)">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE7ED;" FontSize="20" HorizontalAlignment="Left" />
                                            <TextBlock Text="Find phone" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource ActionTile}" Command="{x:Bind Home.ToggleDndCommand}" IsEnabled="{x:Bind Home.QuickActionsEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="Do Not Disturb on the phone">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE708;" FontSize="20" HorizontalAlignment="Left" />
                                            <TextBlock Text="Do not disturb" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ActionTile}" Command="{x:Bind Home.PullScreenshotCommand}" IsEnabled="{x:Bind Home.ScreenshotEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="Save a screenshot of the phone to Pictures\Linc">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE722;" FontSize="20" HorizontalAlignment="Left" />
                                            <TextBlock Text="Screenshot" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Sound" Style="{StaticResource BodyText}" />
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton HorizontalAlignment="Stretch" CornerRadius="20,6,6,20" BorderThickness="0" Padding="0,10"
                                                  IsHitTestVisible="{x:Bind Home.QuickActionsEnabled, Mode=OneWay}" IsChecked="{x:Bind Home.IsSoundNormal, Mode=OneWay}"
                                                  Command="{x:Bind Home.SetSoundCommand}" CommandParameter="normal" Content="Ring" />
                                    <ToggleButton Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="6" BorderThickness="0" Padding="0,10"
                                                  IsHitTestVisible="{x:Bind Home.QuickActionsEnabled, Mode=OneWay}" IsChecked="{x:Bind Home.IsSoundVibrate, Mode=OneWay}"
                                                  Command="{x:Bind Home.SetSoundCommand}" CommandParameter="vibrate" Content="Vibrate" />
                                    <ToggleButton Grid.Column="2" HorizontalAlignment="Stretch" CornerRadius="6,20,20,6" BorderThickness="0" Padding="0,10"
                                                  IsHitTestVisible="{x:Bind Home.QuickActionsEnabled, Mode=OneWay}" IsChecked="{x:Bind Home.IsSoundSilent, Mode=OneWay}"
                                                  Command="{x:Bind Home.SetSoundCommand}" CommandParameter="silent" Content="Silent" />
                                </Grid>
                                <TextBlock Text="{x:Bind Home.QuickActionMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind Home.HasQuickActionMessage, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Display (M5c-2 / D-055): rotation + brightness -->
                        <Border Style="{StaticResource ExpressiveCard}" Padding="20,12">
                            <Expander Header="Display: rotation and brightness" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <StackPanel Spacing="14" Padding="0,12,0,0">
                                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}"
                                           Text="Changes apply through the phone's system settings, which needs Linc's “Modify system settings” permission on the phone." />
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Rotation" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <ComboBox MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind DisplayControl.RotationOptions}"
                                                  SelectedItem="{x:Bind DisplayControl.RotationMode, Mode=OneWay}" IsEnabled="{x:Bind DisplayControl.CanChangeRotation, Mode=OneWay}"
                                                  PlaceholderText="Unknown" SelectionChanged="RotationCombo_SelectionChanged" />
                                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{x:Bind DisplayControl.RotationStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Adaptive brightness" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <ToggleSwitch VerticalAlignment="Center" OnContent="On" OffContent="Off" IsOn="{x:Bind DisplayControl.BrightnessAutoToggleOn, Mode=OneWay}"
                                                      IsEnabled="{x:Bind DisplayControl.CanChangeBrightness, Mode=OneWay}" Toggled="BrightnessAutoToggle_Toggled" />
                                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{x:Bind DisplayControl.BrightnessAutoStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="Brightness" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1"
                                                Value="{x:Bind DisplayControl.BrightnessLevelSlider, Mode=OneWay}" IsEnabled="{x:Bind DisplayControl.IsBrightnessSliderEnabled, Mode=OneWay}"
                                                ValueChanged="BrightnessSlider_ValueChanged" HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" MinWidth="64"
                                                   Text="{x:Bind DisplayControl.BrightnessLevelStatusText, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Bind DisplayControl.StatusText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionText}" Foreground="{ThemeResource ErrorBrush}" Text="{x:Bind DisplayControl.ErrorMessage, Mode=OneWay}"
                                           Visibility="{x:Bind DisplayControl.HasError, Mode=OneWay}" />
                            </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Screen time today (v28): from the phone's own usage records. -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="SCREEN TIME" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Content="Refresh" Command="{x:Bind Extras.RefreshScreenTimeCommand}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Extras.ScreenTimeTotal, Mode=OneWay}" Style="{StaticResource HeadlineText}" />
                                <TextBlock Text="{x:Bind Extras.ScreenTimeDetail, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource TonalButton}" Content="Allow screen time" Command="{x:Bind Extras.AllowScreenTimeCommand}"
                                        Visibility="{x:Bind Extras.UsageNeedsAccess, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind Extras.ScreenTimeApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScreenTimeApp">
                                            <Grid ColumnSpacing="12" Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{x:Bind Fraction}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Time}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- The phone's look (v28): wallpaper through Linc, colours and theme over adb. -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="WALLPAPER AND COLOURS" Style="{StaticResource SectionLabel}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource TonalButton}" Padding="18,10" Command="{x:Bind Extras.WallpaperBothCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE91B;" FontSize="16" />
                                            <TextBlock Text="Choose wallpaper…" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuietButton}" Content="Home only" Command="{x:Bind Extras.WallpaperHomeCommand}" />
                                    <Button Style="{StaticResource QuietButton}" Content="Lock only" Command="{x:Bind Extras.WallpaperLockCommand}" />
                                </StackPanel>
                                <TextBlock Text="Colours" Style="{StaticResource BodyText}" />
                                <ItemsControl ItemsSource="{x:Bind Extras.Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaletteSwatch">
                                            <Button Width="36" Height="36" Padding="0" CornerRadius="18" BorderThickness="0" Background="{x:Bind Brush}"
                                                    Tag="{x:Bind Hex}" Click="OnSwatch" ToolTipService.ToolTip="{x:Bind Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Header="Style" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Extras.Styles}" SelectedItem="{x:Bind Extras.SelectedStyle, Mode=TwoWay}" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource QuietButton}" Content="From wallpaper" Command="{x:Bind Extras.WallpaperColoursCommand}" />
                                </Grid>
                                <ToggleSwitch Header="Dark theme" IsOn="{x:Bind Extras.PhoneDark, Mode=TwoWay}" />
                                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Colours and dark theme change the phone's own settings, so they need USB or Wireless debugging. Colours need Android 12 or later." />
                            </StackPanel>
                        </Border>

                        <!-- The phone's sound on this PC: Windows as the phone's Bluetooth speaker, nothing recorded. -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PHONE SOUND ON THIS PC" Style="{StaticResource SectionLabel}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Style="{StaticResource FilledButton}" Command="{x:Bind Extras.PhoneSoundStartCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE767;" FontSize="16" />
                                            <TextBlock Text="Play here" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource QuietButton}" Content="Stop" Command="{x:Bind Extras.PhoneSoundStopCommand}" />
                                </StackPanel>
                                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Music and videos on the phone play on this PC's speakers, the way a Bluetooth speaker does it. Pair the phone with this PC over Bluetooth once." />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind Extras.Message, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Right: the phone's screen here, then the rest -->
                    <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="20">
                        <!-- Screen mirroring -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="PHONE SCREEN ON THIS PC" Style="{StaticResource SectionLabel}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{x:Bind Mirror.Presets}"
                                              SelectedItem="{x:Bind Mirror.SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Label" Header="Quality" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource FilledButton}" Content="{x:Bind Mirror.ButtonText, Mode=OneWay}"
                                            Command="{x:Bind Mirror.ToggleCommand}" IsEnabled="{x:Bind Mirror.CanMirror, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Mirror.StatusText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{x:Bind Mirror.ErrorMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource ErrorBrush}" Visibility="{x:Bind Mirror.HasError, Mode=OneWay}" />

                                <Expander Header="Mirror settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                    <StackPanel Spacing="14" Padding="0,12,0,0">
                                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="These apply the next time mirroring starts." />
                                        <Grid ColumnSpacing="12" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <NumberBox Header="Max size" Minimum="0" Maximum="4096" SpinButtonPlacementMode="Compact" Value="{x:Bind MirrorSettings.MaxSize, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Header="Video bit rate" Style="{StaticResource ExpressiveTextBox}" PlaceholderText="8M" Text="{x:Bind MirrorSettings.VideoBitRate, Mode=TwoWay}" />
                                            <NumberBox Grid.Row="1" Header="Max FPS" Minimum="0" Maximum="120" SpinButtonPlacementMode="Compact" Value="{x:Bind MirrorSettings.MaxFps, Mode=TwoWay}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Header="Crop" Style="{StaticResource ExpressiveTextBox}" PlaceholderText="1280x720:0:0" Text="{x:Bind MirrorSettings.Crop, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="0, or a blank crop, uses the default." />
                                        <StackPanel Spacing="0">
                                            <ToggleSwitch Header="Stay awake" IsOn="{x:Bind MirrorSettings.StayAwake, Mode=TwoWay}" />
                                            <ToggleSwitch Header="Turn the phone's screen off" IsOn="{x:Bind MirrorSettings.TurnScreenOff, Mode=TwoWay}" />
                                            <ToggleSwitch Header="Show touches" IsOn="{x:Bind MirrorSettings.ShowTouches, Mode=TwoWay}" />
                                            <ToggleSwitch Header="Sound on this PC" IsOn="{x:Bind MirrorSettings.AudioEnabled, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}"
                                                   Text="With sound on, the phone's audio plays here while mirroring and the phone stays silent." />
                                        <Grid ColumnSpacing="12" Visibility="{x:Bind MirrorSettings.AudioEnabled, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Header="Audio source" HorizontalAlignment="Stretch" ItemsSource="{x:Bind MirrorSettings.AudioSources}" SelectedItem="{x:Bind MirrorSettings.AudioSource, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="1" Header="Audio bit rate" Minimum="0" Maximum="512000" SpinButtonPlacementMode="Compact" Value="{x:Bind MirrorSettings.AudioBitRate, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind MirrorSettings.AudioConflictWarning, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" Style="{StaticResource CaptionText}"
                                                   Visibility="{x:Bind MirrorSettings.HasAudioConflictWarning, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind MirrorSettings.ValidationMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" Style="{StaticResource CaptionText}"
                                                   Visibility="{x:Bind MirrorSettings.HasValidationMessage, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind MirrorSettings.StatusMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind MirrorSettings.HasStatusMessage, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Style="{StaticResource FilledButton}" Content="Save" Command="{x:Bind MirrorSettings.SaveCommand}" IsEnabled="{x:Bind MirrorSettings.IsDirty, Mode=OneWay}" />
                                            <Button Style="{StaticResource QuietButton}" Content="Reset to defaults" Command="{x:Bind MirrorSettings.ResetCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Desktop Mode -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="DESKTOP MODE" Style="{StaticResource SectionLabel}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource TonalButton}" Content="{x:Bind DesktopMode.ButtonText, Mode=OneWay}" Command="{x:Bind DesktopMode.ToggleCommand}"
                                            IsEnabled="{x:Bind DesktopMode.CanStart, Mode=OneWay}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DesktopMode.StatusText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{x:Bind DesktopMode.ErrorMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource ErrorBrush}"
                                                   Visibility="{x:Bind DesktopMode.HasError, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}"
                                           Text="A second screen for the phone, to run apps on. The mouse belongs to it while it runs; press Alt or Super to get it back." />
                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind DesktopMode.IsSetupPending, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind DesktopMode.SetupMessage, Mode=OneWay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource TonalButton}" Content="Reboot now" Command="{x:Bind DesktopMode.RebootCommand}" />
                                </StackPanel>

                                <Expander Header="Desktop Mode settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                    <StackPanel Spacing="14" Padding="0,12,0,0">
                                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="These apply the next time Desktop Mode starts. 0 for width, height and DPI lets Linc choose." />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="Width" Minimum="0" Maximum="3840" SpinButtonPlacementMode="Compact" Value="{x:Bind DesktopModeSettings.Width, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="1" Header="Height" Minimum="0" Maximum="3840" SpinButtonPlacementMode="Compact" Value="{x:Bind DesktopModeSettings.Height, Mode=TwoWay}" />
                                            <NumberBox Grid.Column="2" Header="DPI" Minimum="0" Maximum="320" SpinButtonPlacementMode="Compact" Value="{x:Bind DesktopModeSettings.Dpi, Mode=TwoWay}" />
                                        </Grid>
                                        <ComboBox Header="Aspect ratio" MinWidth="200" ItemsSource="{x:Bind DesktopModeSettings.AspectModes}" SelectedItem="{x:Bind DesktopModeSettings.AspectMode, Mode=TwoWay}" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="Max FPS" Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact" Value="{x:Bind DesktopModeSettings.MaxFps, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" Header="Video bit rate" Style="{StaticResource ExpressiveTextBox}" PlaceholderText="8M" Text="{x:Bind DesktopModeSettings.VideoBitRate, Mode=TwoWay}" />
                                        </Grid>
                                        <StackPanel>
                                            <ToggleSwitch Header="Capture mouse" IsOn="{x:Bind DesktopModeSettings.CaptureMouse, Mode=TwoWay}" />
                                            <ToggleSwitch Header="Sound" IsOn="{x:Bind DesktopModeSettings.ForwardAudio, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="Sound is off by default: decoding it costs performance on the second screen." />
                                        <TextBlock Text="{x:Bind DesktopModeSettings.AudioConflictWarning, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" Style="{StaticResource CaptionText}"
                                                   Visibility="{x:Bind DesktopModeSettings.HasAudioConflictWarning, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind DesktopModeSettings.ValidationMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" Style="{StaticResource CaptionText}"
                                                   Visibility="{x:Bind DesktopModeSettings.HasValidationMessage, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind DesktopModeSettings.StatusMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind DesktopModeSettings.HasStatusMessage, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Style="{StaticResource FilledButton}" Content="Save" Command="{x:Bind DesktopModeSettings.SaveCommand}" IsEnabled="{x:Bind DesktopModeSettings.IsDirty, Mode=OneWay}" />
                                            <Button Style="{StaticResource QuietButton}" Content="Reset to recommended" Command="{x:Bind DesktopModeSettings.ResetToRecommendedCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- The rarer things, folded away so the page stays simple (the owner: "hide some stuff"). -->
                        <Expander Header="More: install an app, connection details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <StackPanel Spacing="20" Padding="0,12,0,0">
                        <!-- Install app (M10 Part A) -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="INSTALL AN APP" Style="{StaticResource SectionLabel}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource TonalButton}" Content="Choose an APK…" Command="{x:Bind ViewModel.InstallApkCommand}" IsEnabled="{x:Bind ViewModel.CanInstallApk, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.ApkInstallStatusText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{x:Bind ViewModel.ApkInstallErrorMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource ErrorBrush}"
                                                   Visibility="{x:Bind ViewModel.HasApkInstallError, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="Check the phone: it may ask you to allow the install." />
                            </StackPanel>
                        </Border>

                        <!-- The link: method, override, health -->
                        <Border Style="{StaticResource ExpressiveCard}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="CONNECTION" Style="{StaticResource SectionLabel}" />
                                <ComboBox Header="Connection method" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ConnectionMethods}"
                                          SelectedItem="{x:Bind ViewModel.SelectedConnectionMethod, Mode=TwoWay}" DisplayMemberPath="Label" />
                                <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="Automatic switches to the best link available: USB, then Wireless, then direct Wi-Fi." />
                                <!-- Use this link now (M15a Part C): a one-off override, not the sticky preference above. -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowTransportOverride, Mode=OneWay}">
                                    <TextBlock Text="Use this link now" Style="{StaticResource BodyText}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource QuietButton}" Content="Wireless" Command="{x:Bind ViewModel.UseWirelessNowCommand}" IsEnabled="{x:Bind ViewModel.CanUseWirelessNow, Mode=OneWay}" />
                                        <Button Style="{StaticResource QuietButton}" Content="USB" Command="{x:Bind ViewModel.UseUsbNowCommand}" IsEnabled="{x:Bind ViewModel.CanUseUsbNow, Mode=OneWay}" />
                                        <Button Style="{StaticResource QuietButton}" Content="Automatic" Command="{x:Bind ViewModel.UseAutomaticTransportCommand}" IsEnabled="{x:Bind ViewModel.HasManualTransport, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock views:Explain.IsHelp="True" Style="{StaticResource CaptionText}" Text="A link picked here stays until you go back to automatic or it stops answering." />
                                </StackPanel>
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Reconnects" Style="{StaticResource CaptionText}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ReconnectCount, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <TextBlock Grid.Row="1" Text="Protocol" Style="{StaticResource CaptionText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ProtocolVersion, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <TextBlock Grid.Row="2" Text="Serial" Style="{StaticResource CaptionText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DeviceSerial, Mode=OneWay}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="True" />
                                </Grid>
                            </StackPanel>
                        </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
