<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views">

    <Grid views:PageLayout.Adaptive="True" Padding="32">
        <StackPanel Spacing="16" VerticalAlignment="Top">
            <TextBlock Text="Details" Style="{StaticResource HeadlineText}" />
            <TextBlock views:Explain.IsHelp="True"
                Style="{StaticResource BodyText}"
                Text="A few fun (and occasionally useful) facts about your phone, live from the connection." />

            <!-- No phone yet (or nothing heard from it this run): say so, instead of rows of "—". -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20" Visibility="{x:Bind ViewModel.HasNoStats, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE8EA;" FontSize="22" VerticalAlignment="Top" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Connect your phone to see these" Style="{StaticResource TitleText}" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Text="CPU, memory, Wi-Fi and uptime come live from the phone once it's connected, and keep updating while it is." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ExpressiveCard}" Padding="20" Visibility="{x:Bind ViewModel.HasStats, Mode=OneWay}">
                <Grid RowSpacing="16" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="CPU load (1 min)" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource TitleText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Memory" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Bind ViewModel.RamText, Mode=OneWay}" Style="{StaticResource TitleText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="Wi-Fi" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Bind ViewModel.WifiText, Mode=OneWay}" Style="{StaticResource TitleText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Uptime" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" Style="{StaticResource TitleText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource ExpressiveCard}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="This session" Style="{StaticResource TitleText}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Screen mirroring" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Bind ViewModel.MirrorStatsText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Notifications" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{x:Bind ViewModel.NotificationStatsText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
