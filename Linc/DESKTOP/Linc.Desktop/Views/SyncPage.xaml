<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:vm="using:Linc.Desktop.ViewModels">

    <Page.Resources>
        <Style x:Key="LaneTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{ThemeResource SurfaceContainerHighBrush}" />
        </Style>
    </Page.Resources>

    <Grid views:PageLayout.Adaptive="True" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Offline sync-cache banner (M9d-2, §3.5) — same text/rule as Home's, reusing
             HomeOfflineBanner.FormatText rather than a second formatter. -->
        <Border Grid.Row="0" Background="{ThemeResource SecondaryContainerBrush}"
                CornerRadius="14" Padding="14,10"
                Visibility="{x:Bind ViewModel.ShowOfflineBanner, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                <TextBlock Text="{x:Bind ViewModel.OfflineBannerText, Mode=OneWay}" FontSize="13"
                           VerticalAlignment="Center" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
            </StackPanel>
        </Border>

        <!-- What syncs (lanes), then the Folders lane's pairs: each a PC folder and a phone
             folder kept the same, both ways or one way. The phone's Sync page (v30) shows and
             edits the same setup. -->
        <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16">
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sync" Style="{StaticResource HeadlineText}" />
                    <Grid x:Name="LaneTiles" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <Border Style="{StaticResource LaneTile}" Grid.Row="0" Grid.Column="0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SecondaryContainerBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Folders" Style="{StaticResource TitleText}" FontSize="16" />
                                <TextBlock Text="Folders you choose, kept the same" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                          AutomationProperties.Name="Folders"
                                          IsOn="{x:Bind ViewModel.FoldersOn, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource LaneTile}" Grid.Row="0" Grid.Column="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SecondaryContainerBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Photos" Style="{StaticResource TitleText}" FontSize="16" />
                                <TextBlock Text="New camera photos copy to this PC" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                          AutomationProperties.Name="Photos"
                                          IsOn="{x:Bind ViewModel.PhotosOn, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource LaneTile}" Grid.Row="1" Grid.Column="0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SecondaryContainerBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8BD;" FontSize="18" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Messages" Style="{StaticResource TitleText}" FontSize="16" />
                                <TextBlock Text="Read and reply to texts here" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                          AutomationProperties.Name="Messages"
                                          IsOn="{x:Bind ViewModel.MessagesOn, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource LaneTile}" Grid.Row="1" Grid.Column="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SecondaryContainerBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE717;" FontSize="18" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Calls" Style="{StaticResource TitleText}" FontSize="16" />
                                <TextBlock Text="Call log and dialling" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                          AutomationProperties.Name="Calls"
                                          IsOn="{x:Bind ViewModel.CallsOn, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.LaneMessage, Mode=OneWay}"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </Border>

            <!-- Folders lane: one card per pair (M18c, v30 pairs). -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16" Visibility="{x:Bind ViewModel.ShowFolderConfig, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Folders" Style="{StaticResource TitleText}" />
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                       Text="Pick a folder on this PC and one on the phone; Linc keeps them the same." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource FilledButton}" Padding="16,10" Click="OnAddPair"
                                AutomationProperties.Name="Add folder pair">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border CornerRadius="20" Padding="18,16" Background="{ThemeResource SurfaceContainerHighBrush}"
                            Visibility="{x:Bind ViewModel.HasNoPairs, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8F4;" FontSize="22" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                       Text="No folders yet. Add one: Documents, Music, a work folder — anything that should be the same on both." />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Pairs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderPairVm">
                                <Border CornerRadius="20" Padding="16,14" Background="{ThemeResource SurfaceContainerHighBrush}"
                                        Opacity="{x:Bind CardOpacity, Mode=OneWay}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="12" Background="{ThemeResource PrimaryContainerBrush}">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DirectionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                                          AutomationProperties.Name="Sync this folder"
                                                          IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            <Button Grid.Column="3" Style="{StaticResource QuietButton}" Padding="10" BorderThickness="0"
                                                    ToolTipService.ToolTip="Edit" AutomationProperties.Name="Edit folder pair" Click="OnEditPair">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="4" Style="{StaticResource QuietButton}" Padding="10" BorderThickness="0"
                                                    ToolTipService.ToolTip="Stop syncing this folder" AutomationProperties.Name="Remove folder pair" Click="OnRemovePair">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="14" Padding="12,8" Background="{ThemeResource SurfaceContainerBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                                    <TextBlock Text="{x:Bind PcPath, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind PcPath, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                            <FontIcon Grid.Column="1" Glyph="{x:Bind ArrowGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" />
                                            <Border Grid.Column="2" CornerRadius="14" Padding="12,8" Background="{ThemeResource SurfaceContainerBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8EA;" FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                                    <TextBlock Text="{x:Bind PhonePath, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind PhonePath, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock views:Explain.IsHelp="True" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               Text="Deletes are never copied, so nothing is lost by accident. Top-level files only." />
                </StackPanel>
            </Border>

            <!-- Photos lane info: pull-only from the phone camera roll (M18c). -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,14" Visibility="{x:Bind ViewModel.ShowPhotosInfo, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               Text="{x:Bind ViewModel.PhotosInfo, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" Padding="4,0" Visibility="{x:Bind ViewModel.ShowSyncBar, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                    Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource TonalButton}"
                    Padding="16,8"
                    Content="Sync now"
                    Command="{x:Bind ViewModel.SyncNowCommand}" />
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- Messages & Calls sit side by side; a solo lane spans both columns
             (SyncPage code-behind manages the span). M07 polish. -->
        <Grid Grid.Row="2" x:Name="LaneArea" ColumnSpacing="16" views:PageLayout.StackBelow="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Messages lane: conversations | thread + reply. -->
            <Border x:Name="MessagesCard" Style="{StaticResource ExpressiveCard}" Padding="0"
                    Visibility="{x:Bind ViewModel.ShowMessagesPanel, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListView
                    ItemsSource="{x:Bind ViewModel.Conversations}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    Padding="8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationVm">
                            <StackPanel Spacing="2" Padding="6,8">
                                <TextBlock Text="{x:Bind Address}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{x:Bind Snippet, Mode=OneWay}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Column="1" Padding="16" RowSpacing="10"
                      BorderThickness="1,0,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{x:Bind ViewModel.Selected.Messages, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageVm">
                                <Grid Padding="0,3">
                                    <Border
                                        MaxWidth="440"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        HorizontalAlignment="{x:Bind Alignment}"
                                        Background="{x:Bind Bubble}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" FontSize="13" />
                                            <!-- §3.3: a queued message never looks identical to a sent one — the
                                                 "Queued" label plus a muted timestamp, not colour alone. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Queued" FontSize="11" FontWeight="SemiBold"
                                                           Opacity="0.6"
                                                           Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind TimeText}" FontSize="11"
                                                           Opacity="{x:Bind TimestampOpacity, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="1" ColumnSpacing="8" Visibility="{x:Bind ViewModel.CanReply, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Style="{StaticResource ExpressiveTextBox}"
                            Text="{x:Bind ViewModel.ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Text back…" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource FilledButton}"
                            Padding="20,10"
                            Content="Send"
                            Command="{x:Bind ViewModel.SendReplyCommand}" />
                    </Grid>
                </Grid>

                <!-- Empty / disconnected state (M07). -->
                <TextBlock Grid.ColumnSpan="2"
                    Style="{StaticResource BodyText}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                    Text="{x:Bind ViewModel.MessagesPlaceholder, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowMessagesPlaceholder, Mode=OneWay}" />
            </Grid>
            </Border>

            <!-- Calls lane: incoming banner, dialer, call log. -->
            <Border x:Name="CallsCard" Grid.Column="1" Style="{StaticResource ExpressiveCard}" Padding="20"
                    Visibility="{x:Bind ViewModel.ShowCallsPanel, Mode=OneWay}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Incoming-call banner. -->
                <Border
                    Background="{ThemeResource TertiaryContainerBrush}"
                    CornerRadius="16"
                    Padding="16,12"
                    Visibility="{x:Bind ViewModel.IncomingRinging, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.IncomingText, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OnTertiaryContainerBrush}" />
                        <Button
                            Grid.Column="1"
                            Content="Decline"
                            Background="{ThemeResource ErrorBrush}"
                            Foreground="{ThemeResource OnPrimaryBrush}"
                            BorderThickness="0"
                            CornerRadius="20"
                            Padding="18,8"
                            Command="{x:Bind ViewModel.DeclineCommand}" />
                    </Grid>
                </Border>

                <!-- Dialer. -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Style="{StaticResource ExpressiveTextBox}"
                        Text="{x:Bind ViewModel.DialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Enter a number to call from your phone…"
                        InputScope="TelephoneNumber" />
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource FilledButton}"
                        Padding="20,10"
                        Content="Call"
                        Command="{x:Bind ViewModel.DialCommand}" />
                </Grid>

                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Calls}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CallVm">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" VerticalAlignment="Center"
                                          Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="11"
                                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Width="34" Height="34" Padding="0" CornerRadius="17"
                                    Background="{ThemeResource SecondaryContainerBrush}" BorderThickness="0"
                                    Command="{x:Bind DialCommand}"
                                    ToolTipService.ToolTip="Call this number from your phone">
                                    <FontIcon Glyph="&#xE717;" FontSize="13"
                                              Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty / disconnected state (M07). -->
                <TextBlock Grid.Row="2"
                    Style="{StaticResource BodyText}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                    Text="{x:Bind ViewModel.CallsPlaceholder, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowCallsPlaceholder, Mode=OneWay}" />
            </Grid>
            </Border>

            <!-- When neither Messages nor Calls is on. -->
            <TextBlock
                Grid.ColumnSpan="2"
                Style="{StaticResource BodyText}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                TextAlignment="Center"
                Text="Turn on a lane above to sync it with this PC. Folders and Photos sync files here automatically; Messages and Calls need their permission on the phone (Settings on the phone)."
                Visibility="{x:Bind ViewModel.NeitherLane, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
