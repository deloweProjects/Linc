<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Phones (M2a): every phone paired with this PC, the management home the tab strip's
     +/close flow complements, and the phone's saved offline copy. -->
<UserControl
    x:Class="Linc.Desktop.Views.Settings.DevicesSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:s="using:Linc.Desktop.Views.Settings">

    <StackPanel>
        <s:SettingsGroup Title="Paired phones" Keywords="devices pair unpair remove forget"
                         Description="Every phone paired with this PC. Open switches to it (and re-opens a closed tab); Remove unpairs it and deletes its saved copy — the same as Remove completely on its tab.">
            <!-- M15c A2: the limit, stated where a phone gets added rather than after. -->
            <s:SettingRow Header="One phone at a time" IsHelp="False"
                          Visibility="{x:Bind ViewModel.ShowOneAtATimeNote, Mode=OneWay}"
                          Description="{x:Bind ViewModel.OneAtATimeText, Mode=OneWay}" />
            <s:SettingRow Header="No phones yet" IsHelp="False" Keywords="pair"
                          Visibility="{x:Bind ViewModel.HasNoKnownDevices, Mode=OneWay}"
                          Description="Pair one with the + beside the tabs at the top, or from Home." />
            <ItemsControl ItemsSource="{x:Bind ViewModel.KnownDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KnownDeviceVm">
                        <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="18" Padding="18,12" Margin="0,0,0,6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SecondaryContainerBrush}">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="18" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="13">
                                        <Run Text="{x:Bind Serial}" FontFamily="Consolas" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind StateText}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Open" VerticalAlignment="Center"
                                        Command="{x:Bind SetActiveCommand}" Visibility="{x:Bind IsNotActive}" />
                                <Button Grid.Column="3" Content="Remove…" VerticalAlignment="Center"
                                        Command="{x:Bind ForgetCommand}"
                                        ToolTipService.ToolTip="Unpair this phone and delete its saved copy (asks first)" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Saved on this PC" Keywords="cache offline copy wallpaper thumbnails">
            <s:SettingRow Header="Clear saved phone data"
                          Description="Drops the offline copy of this phone (stats, wallpaper, photo thumbnails) without unpairing it. It fills in again once the phone connects.">
                <Button Content="Clear" Command="{x:Bind ViewModel.ClearDeviceDataCommand}" />
            </s:SettingRow>
        </s:SettingsGroup>
    </StackPanel>
</UserControl>
