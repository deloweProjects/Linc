<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Connection: how the PC and the phone link up, the PC hotspot, and the Connection Doctor. -->
<UserControl
    x:Class="Linc.Desktop.Views.Settings.ConnectionSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:Linc.Desktop.Views.Settings">

    <StackPanel>
        <s:SettingsGroup Title="How Linc connects" Keywords="usb cable wifi wi-fi network adb link">
            <s:SettingRow Header="Allow USB connections" Keywords="cable">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.AllowUsbConnections, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="Background connection" IsHelp="False"
                          Description="The phone finds this PC by itself, no ADB needed.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.BackgroundConnectionEnabled, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="New connection engine" IsHelp="False" Keywords="linclink faster"
                          Description="Finds the phone faster on any Wi-Fi, and short drops never show. Off: the way Linc always connected.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.LincLinkEnabled, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="Encrypt Wi-Fi links" IsHelp="False" Keywords="security tls 5555 private"
                          Description="When Linc rides plain ADB over Wi-Fi (port 5555, which anyone on the network could read), switch to the encrypted direct link. Mirror, Tools and fast file copies then need wireless debugging or the cable. Needs the new connection engine.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.EncryptWifiLinks, Mode=TwoWay}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <!-- PC hotspot: the PC's own Wi-Fi for the phone, even with no internet (LincLink step 6, by hand). -->
        <s:SettingsGroup Title="PC hotspot" Keywords="wifi direct mobile hotspot offline no internet">
            <s:SettingRow Header="PC hotspot" IsHelp="False" Keywords="qr join"
                          Description="No shared Wi-Fi and no cable? This PC makes its own Wi-Fi for the phone, even with no internet (Windows' own Mobile Hotspot refuses then). The phone joins it once; Linc finds the PC on it by itself.">
                <Button x:Name="HotspotButton" Content="Start PC hotspot" Click="OnHotspotClick" />
                <s:SettingRow.Below>
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="HotspotStatus" Text="Off" Style="{StaticResource BodyText}" FontSize="13" Opacity="0.85" />
                        <StackPanel x:Name="HotspotDetails" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                            <Border Background="White" CornerRadius="16" Padding="8">
                                <Image x:Name="HotspotQr" Width="140" Height="140" />
                            </Border>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="On the phone: scan this with the camera, or join" Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="HotspotSsid" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="HotspotPassword" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </s:SettingRow.Below>
            </s:SettingRow>
            <s:SettingRow Header="Start the PC hotspot when the phone is near" IsHelp="False" Keywords="automatic bluetooth"
                          Description="When this PC hears the phone over Bluetooth but can't reach it for 20 s, it starts the hotspot and the phone joins it by itself (the phone learns the network while connected, and asks you once). Off again after 3 minutes if the phone doesn't come. Needs the new connection engine.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.AutoHotspot, Mode=TwoWay}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="When it won't connect" Keywords="problem trouble fix firewall vpn">
            <s:SettingRow Header="Connection Doctor"
                          Description="Checks what can stop the PC and phone finding each other (firewall, network type, VPN, Wi-Fi isolation, the phone's battery settings) and fixes what it can.">
                <Button Content="Run the Doctor" Style="{StaticResource TonalButton}" Padding="20,10" Click="OnConnectionDoctorClick" />
            </s:SettingRow>
            <s:SettingRow Header="Resume auto-reconnect" Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                          Description="Linc stopped looking for the phone. This starts again.">
                <Button Content="Resume" Command="{x:Bind ViewModel.ResumeAutomaticCommand}" />
            </s:SettingRow>
        </s:SettingsGroup>
    </StackPanel>
</UserControl>
