<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Appearance (M18 B1 and after): layout, typeface, colours, the clock on Home, and the
     Linc Island and Linc Bubble. -->
<UserControl
    x:Class="Linc.Desktop.Views.Settings.AppearanceSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:s="using:Linc.Desktop.Views.Settings">

    <StackPanel>
        <s:SettingsGroup Title="Colours and background" Keywords="theme colour color tint dark light">
            <s:SettingRow Header="Use my phone's colours" Keywords="dynamic material you accent"
                          Description="Tints Linc with your phone wallpaper's main colour. Off uses Linc's own black-and-white theme.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.UsePhoneColours, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="Wallpaper as background" Keywords="blur backdrop"
                          Description="Your phone's wallpaper, blurred, behind everything. Off: the plain background, in your phone's colours, with solid cards.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.WallpaperBackdrop, Mode=TwoWay}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Layout and text" Keywords="font typeface navigation">
            <s:SettingRow Header="Navigation" Keywords="floating bar side rail dock menu"
                          Description="Where the pages live: icons in a bar along the bottom (hover one to see its name), or down the left with their names.">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton GroupName="NavStyle" Content="Floating bar" IsChecked="{x:Bind ViewModel.FloatingNav, Mode=TwoWay}" />
                    <RadioButton GroupName="NavStyle" Content="Side rail" IsChecked="{x:Bind ViewModel.SideRailNav, Mode=TwoWay}" />
                </StackPanel>
            </s:SettingRow>
            <s:SettingRow Header="Font" Keywords="inter manrope outfit jakarta segoe typeface"
                          Description="The typeface across Linc. Default is Windows' own Segoe UI.">
                <s:SettingRow.Below>
                    <!-- AppFonts.Keep: these previews stay in their own typefaces whatever the app uses. -->
                    <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.AppFontIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Font" views:AppFonts.Keep="True">
                        <RadioButton AutomationProperties.Name="Default font">
                            <StackPanel Spacing="0" MinWidth="96">
                                <TextBlock Text="Aa" FontFamily="Segoe UI Variable Text" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Default" FontFamily="Segoe UI Variable Text" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Inter font">
                            <StackPanel Spacing="0" MinWidth="96">
                                <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/Inter.ttf#Inter" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Inter" FontFamily="ms-appx:///Assets/Fonts/Inter.ttf#Inter" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Plus Jakarta Sans font">
                            <StackPanel Spacing="0" MinWidth="96">
                                <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/PlusJakartaSans.ttf#Plus Jakarta Sans" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Plus Jakarta Sans" FontFamily="ms-appx:///Assets/Fonts/PlusJakartaSans.ttf#Plus Jakarta Sans" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Manrope font">
                            <StackPanel Spacing="0" MinWidth="96">
                                <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/Manrope.ttf#Manrope" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Manrope" FontFamily="ms-appx:///Assets/Fonts/Manrope.ttf#Manrope" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Outfit font">
                            <StackPanel Spacing="0" MinWidth="96">
                                <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Outfit" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                </s:SettingRow.Below>
            </s:SettingRow>
            <s:SettingRow Header="Show explanations" IsHelp="False" Keywords="help hints descriptions"
                          Description="The short lines that explain each setting. Warnings, errors and the reason something can't be used always show.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.ShowExplanations, Mode=TwoWay}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Linc Island and Linc Bubble" Keywords="island bubble pill desktop floating overlay">
            <s:SettingRow Header="Linc Island" Keywords="pill title bar live activity"
                          Description="A dark pill at the top of your phone on Home (and in the title bar on other pages) that shows what's happening: a file sending, a call, music, mirroring, reconnecting, low battery. Click it for buttons.">
                <ToggleSwitch OnContent="On" OffContent="Off" AutomationProperties.AutomationId="LiveIslandToggle"
                              IsOn="{x:Bind ViewModel.LiveIsland, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="Linc Bubble" Keywords="desktop overlay shortcuts"
                          Description="A small Linc bubble on your desktop, over every app. Drag it anywhere; it tucks itself into the screen edge when you're not using it. It grows into the island when something happens, and a click opens Linc's shortcuts (mirror, ring, send the clipboard, PC hotspot…).">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.LiveBubble, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="Bubble size" Keywords="linc bubble small large"
                          Visibility="{x:Bind ViewModel.LiveBubble, Mode=OneWay}"
                          Description="How big the Linc Bubble is on your desktop. Its shortcuts: click the bubble, then the pencil.">
                <Slider Width="200" Minimum="28" Maximum="64" StepFrequency="2" SmallChange="2"
                        AutomationProperties.Name="Bubble size"
                        Value="{x:Bind ViewModel.BubbleSizeValue, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="When the bubble is idle" Keywords="linc bubble slim tab hidden edge"
                          Visibility="{x:Bind ViewModel.LiveBubble, Mode=OneWay}"
                          Description="Slim tab: it slides into the screen edge as a thin tab. Hidden: nothing shows until you move the pointer to that edge or something happens. Always a bubble: it stays as it is.">
                <ComboBox MinWidth="160" AutomationProperties.Name="When the bubble is idle"
                          SelectedIndex="{x:Bind ViewModel.BubbleIdleIndex, Mode=TwoWay}">
                    <x:String>Slim tab</x:String>
                    <x:String>Hidden</x:String>
                    <x:String>Always a bubble</x:String>
                </ComboBox>
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Clock on Home" Keywords="time date lock screen">
            <s:SettingRow Header="Clock on Home"
                          Description="The time and date on your phone's wallpaper, like its lock screen.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.HomeClock, Mode=TwoWay}" />
            </s:SettingRow>
            <s:SettingRow Header="Clock style" Keywords="classic bold stacked serif minimal"
                          Description="How the clock on Home looks.">
                <s:SettingRow.Below>
                    <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ClockStyleIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Clock style">
                        <RadioButton AutomationProperties.Name="Classic clock">
                            <StackPanel Spacing="4">
                                <Border Width="116" Height="68" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0" />
                                            <GradientStop Color="#FF121212" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Tuesday, 20 October" FontSize="7" FontWeight="Medium" Foreground="White" Opacity="0.92" HorizontalAlignment="Center" />
                                        <TextBlock Text="9:41" FontSize="32" FontWeight="Light" CharacterSpacing="-40" Foreground="White" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Classic" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Bold clock">
                            <StackPanel Spacing="4">
                                <Border Width="116" Height="68" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0" />
                                            <GradientStop Color="#FF121212" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="TUESDAY, 20 OCTOBER" FontSize="6" FontWeight="SemiBold" CharacterSpacing="160" Foreground="White" Opacity="0.92" HorizontalAlignment="Center" />
                                        <TextBlock Text="9:41" FontSize="30" FontWeight="Bold" CharacterSpacing="-60" Foreground="White" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Bold" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Stacked clock">
                            <StackPanel Spacing="4">
                                <Border Width="116" Height="68" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0" />
                                            <GradientStop Color="#FF121212" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock FontSize="26" FontWeight="Medium" CharacterSpacing="-20" Foreground="White"
                                               TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Run Text="09" /><LineBreak /><Run Text="41" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="Stacked" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Serif clock">
                            <StackPanel Spacing="4">
                                <Border Width="116" Height="68" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0" />
                                            <GradientStop Color="#FF121212" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Tuesday, 20 October" FontSize="8" FontFamily="ms-appx:///Assets/Fonts/DMSerifDisplay.ttf#DM Serif Display" Foreground="White" Opacity="0.92" HorizontalAlignment="Center" />
                                        <TextBlock Text="9:41" FontSize="32" FontFamily="ms-appx:///Assets/Fonts/DMSerifDisplay.ttf#DM Serif Display" CharacterSpacing="-10" Foreground="White" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Serif" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Minimal clock">
                            <StackPanel Spacing="4">
                                <Border Width="116" Height="68" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0" />
                                            <GradientStop Color="#FF121212" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                        <TextBlock Text="9:41" FontSize="17" FontWeight="SemiLight" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="Tuesday, 20 October 2026" FontSize="8" Foreground="White" Opacity="0.85" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Minimal" FontSize="12" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                </s:SettingRow.Below>
            </s:SettingRow>
        </s:SettingsGroup>
    </StackPanel>
</UserControl>
