<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Notifications: the relay, and notification history (M9b, D-045: opt-in, default OFF). -->
<UserControl
    x:Class="Linc.Desktop.Views.Settings.NotificationSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:Linc.Desktop.Views.Settings">

    <StackPanel>
        <s:SettingsGroup Title="From your phone" Keywords="alerts messages sync">
            <s:SettingRow Header="Notification relay" Keywords="show phone notifications on pc">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.NotificationSyncEnabled, Mode=TwoWay}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Notification history" Keywords="keep store saved privacy">
            <!-- The switch's own label always shows; only the explanation follows Show explanations. -->
            <s:SettingRow Header="Keep notification history"
                          Description="Save notifications on this PC so you can see them after they are dismissed elsewhere.">
                <ToggleSwitch OnContent="On" OffContent="Off" AutomationProperties.Name="Keep notification history"
                              IsOn="{x:Bind ViewModel.NotificationHistoryEnabled, Mode=TwoWay}" />
            </s:SettingRow>
            <!-- Retention picker: 7 / 30 / 90 days, default 30. Disabled while the toggle is off (§2.6). -->
            <s:SettingRow Header="Keep history for" Keywords="days retention">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="7 days" MinWidth="0" IsChecked="{x:Bind ViewModel.IsHistory7Days, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsHistoryRetentionEnabled, Mode=OneWay}" GroupName="HistoryRetention" />
                    <RadioButton Content="30 days" MinWidth="0" IsChecked="{x:Bind ViewModel.IsHistory30Days, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsHistoryRetentionEnabled, Mode=OneWay}" GroupName="HistoryRetention" />
                    <RadioButton Content="90 days" MinWidth="0" IsChecked="{x:Bind ViewModel.IsHistory90Days, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsHistoryRetentionEnabled, Mode=OneWay}" GroupName="HistoryRetention" />
                </StackPanel>
            </s:SettingRow>
            <s:SettingRow Header="Clear notification history" IsHelp="False" Keywords="delete erase"
                          Description="When on, notification bodies are stored on this PC. History is kept per device. Turning it OFF stops new ones but does NOT delete what is already stored — use Clear history for that.">
                <Button Content="Clear history" Click="OnClearHistoryClick" ToolTipService.ToolTip="Delete every stored notification, for all devices" />
            </s:SettingRow>
        </s:SettingsGroup>
    </StackPanel>
</UserControl>
