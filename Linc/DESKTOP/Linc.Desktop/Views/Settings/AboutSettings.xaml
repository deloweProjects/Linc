<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › About (the owner, 2026-11-03: "especially the About section bro, it's ugly"): the Linc
     mark, the version and build channel, updates, the phone's Linc, what's new, links, credits and
     licences (as in the repository's NOTICE; links shared with the phone's Settings › About,
     service/ProjectLinks.kt), and a copy of the diagnostic info. -->
<UserControl
    x:Class="Linc.Desktop.Views.Settings.AboutSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:s="using:Linc.Desktop.Views.Settings">

    <StackPanel>
        <!-- The mark, the name, the version. -->
        <Border Style="{StaticResource HeroCard}" Padding="28" Margin="0,0,0,16">
            <Grid ColumnSpacing="24" RowSpacing="16" views:PageLayout.StackBelow="640">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="112" Height="112" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Fill="{ThemeResource OnPrimaryContainerBrush}" Opacity="0.08" Margin="-10" />
                    <Image Source="ms-appx:///Assets/linc-bubble.png" Width="112" Height="112" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.AppName}" FontSize="40" FontWeight="Bold"
                               Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" FontSize="15" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource OnPrimaryContainerBrush}" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C1;" FontSize="12" Visibility="{x:Bind ViewModel.IsTestBuild}" />
                                <TextBlock Text="{x:Bind ViewModel.ChannelText}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="12,5">
                            <TextBlock Text="{x:Bind ViewModel.BuildDateText}" FontSize="13" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Your phone and your PC, as one. No account, no cloud: the two talk straight to each other."
                               FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{ThemeResource OnPrimaryContainerBrush}" Opacity="0.75" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Updates (M19 C3): one switch, default ON. There is no address to configure - the
             manifest is Releases/update.json in Linc's own repo, baked in at build time. -->
        <s:SettingsGroup Title="Updates" Keywords="update upgrade new version check">
            <s:SettingRow Header="Check for updates" IsHelp="False" Keywords="check now"
                          Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}">
                <Button Content="Check now" Style="{StaticResource FilledButton}" Padding="22,10"
                        Command="{x:Bind ViewModel.CheckForUpdatesNowCommand}" />
                <s:SettingRow.Below>
                    <TextBlock Text="{x:Bind ViewModel.UpdateCheckResult, Mode=OneWay}" Style="{StaticResource BodyText}" FontSize="13"
                               FontWeight="SemiBold" Visibility="{x:Bind ViewModel.HasUpdateCheckResult, Mode=OneWay}" />
                </s:SettingRow.Below>
            </s:SettingRow>
            <s:SettingRow Header="Keep Linc up to date" Keywords="automatic"
                          Description="Off means Linc never checks for anything. You can still update by hand from the Releases page.">
                <ToggleSwitch OnContent="On" OffContent="Off" IsOn="{x:Bind ViewModel.UpdatesEnabled, Mode=TwoWay}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Linc on your phone" Keywords="phone version android companion">
            <s:SettingRow Header="{x:Bind ViewModel.PhoneAboutTitle, Mode=OneWay}" IsHelp="False" Keywords="phone app version protocol"
                          Description="{x:Bind ViewModel.PhoneAboutText, Mode=OneWay}">
                <FontIcon Glyph="&#xE8EA;" FontSize="22" Opacity="0.7" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="What's new" Keywords="changes release notes changelog" Visibility="{x:Bind ViewModel.HasWhatsNew}">
            <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="18" Padding="20,16" Margin="0,0,0,6">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.WhatsNewTitle}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{x:Bind ViewModel.WhatsNewLead}" Style="{StaticResource BodyText}" FontSize="13"
                               Visibility="{x:Bind ViewModel.HasWhatsNewLead}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WhatsNewItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="12" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" Style="{StaticResource BodyText}" FontSize="14"
                                               Foreground="{ThemeResource OnSurfaceBrush}" IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{x:Bind ViewModel.ShowAllNotesText, Mode=OneWay}" Style="{StaticResource QuietButton}" Padding="16,8"
                            Command="{x:Bind ViewModel.ToggleAllNotesCommand}" Visibility="{x:Bind ViewModel.CanShowAllNotes}" />
                </StackPanel>
            </Border>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Links" Keywords="telegram github source issue help website">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AboutLinks}" Margin="0,0,0,6">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="72" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AboutLink">
                        <Button Style="{StaticResource ActionTile}" VerticalAlignment="Stretch" Command="{x:Bind Command}"
                                AutomationProperties.Name="{x:Bind Title}" CornerRadius="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SecondaryContainerBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Built with" Keywords="credits licences licenses third party notices open source scrcpy">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AboutCredits}" Margin="0,0,0,6">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="260" MinItemHeight="76" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AboutCredit">
                        <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="18" Padding="16,12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Role}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Licence}" Style="{StaticResource LabelText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <s:SettingRow Header="Licences and notices" Keywords="third party notices"
                          Description="The full licence of everything Linc ships with.">
                <Button Content="Open" Command="{x:Bind ViewModel.OpenNoticesCommand}" />
            </s:SettingRow>
        </s:SettingsGroup>

        <s:SettingsGroup Title="Made by" Keywords="author delowe deloweprojects copyright mit fingerprint">
            <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="18" Padding="18,14" Margin="0,0,0,6">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource OnSurfaceBrush}">
                        <Run Text="Made by " /><Hyperlink NavigateUri="https://github.com/deloweProjects/Linc">deloweProjects</Hyperlink><Run Text=" (delowe, @delow3)." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13">
                        <Run Text="Free and open source under the " /><Hyperlink NavigateUri="https://github.com/deloweProjects/Linc/blob/main/LICENSE">MIT License</Hyperlink><Run Text=". " /><Run Text="{x:Bind ViewModel.CopyrightText}" /><Run Text="." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource LabelText}" FontSize="12" Margin="0,4,0,0" Text="Project fingerprint (SHA-256 of &quot;Linc by deloweProjects — https://github.com/deloweProjects/Linc&quot;)" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.FingerprintText}" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </Border>
            <s:SettingRow Header="Copy diagnostic info" Keywords="bug report support debug version"
                          Description="Versions, Windows, the link and the connection switches, ready to paste into a message or an issue. No serial numbers, network names or file paths.">
                <Button Content="Copy" Command="{x:Bind ViewModel.CopyDiagnosticsCommand}" />
                <s:SettingRow.Below>
                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsResult, Mode=OneWay}" Style="{StaticResource BodyText}" FontSize="13"
                               Visibility="{x:Bind ViewModel.HasDiagnosticsResult, Mode=OneWay}" />
                </s:SettingRow.Below>
            </s:SettingRow>
        </s:SettingsGroup>
    </StackPanel>
</UserControl>
