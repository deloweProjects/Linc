<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:local="using:Linc.Desktop.Views">

    <Page.Resources>
        <local:LogLevelToBrushConverter x:Key="LevelBrushConverter" />
    </Page.Resources>

    <Grid Padding="32">
        <Border Style="{StaticResource ExpressiveCard}" Padding="20">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Logs" Style="{StaticResource HeadlineText}" VerticalAlignment="Center" />
                    <Button Content="Open log folder" Command="{x:Bind ViewModel.OpenLogFolderCommand}" Margin="16,0,0,0" />
                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearCommand}" />
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryVm">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                                <TextBlock
                                    Text="{x:Bind TimeText}"
                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                    FontFamily="Consolas"
                                    Width="72" />
                                <TextBlock
                                    Text="{x:Bind Message}"
                                    TextWrapping="Wrap"
                                    Foreground="{x:Bind Level, Converter={StaticResource LevelBrushConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
