<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:tools="using:Linc.Desktop.Views.Tools"
    xmlns:svc="using:Linc.Desktop.Services.Tools"
    xmlns:vmt="using:Linc.Desktop.ViewModels.Tools">

    <Grid views:PageLayout.Adaptive="True" Padding="24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--   the rail: one pill per section, Console under "Advanced". A ListView, so the
             screenshot test can select sections through UI Automation. Labels hide on a narrow
             window and the icons stay.   -->
        <Grid RowSpacing="4" MinWidth="64" MaxWidth="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Tools" Style="{StaticResource HeadlineText}" Margin="8,0,8,8" views:PageLayout.HideBelow="900" />
            <ListView Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="Tools sections"
                      ItemsSource="{x:Bind ViewModel.Sections}"
                      SelectedItem="{x:Bind ViewModel.SelectedSectionItem, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="CornerRadius" Value="{StaticResource ShapeFull}" />
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="MinHeight" Value="44" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vmt:ToolsSectionItem">
                        <StackPanel Spacing="2" ToolTipService.ToolTip="{x:Bind Hint}">
                            <Border Visibility="{x:Bind StartsAdvanced}">
                                <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}" FontSize="11" Margin="0,12,0,4"
                                           views:PageLayout.HideBelow="900" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,10">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                <TextBlock Text="{x:Bind Name}" FontSize="14" views:PageLayout.HideBelow="900" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--   the section   -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Which phone, and what just happened. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="14" Padding="14,8"
                        HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" TextWrapping="Wrap" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                        <Button Style="{StaticResource QuietButton}" BorderThickness="0" Padding="6" MinWidth="0"
                                AutomationProperties.Name="Dismiss" Command="{x:Bind ViewModel.ClearNoticeCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Border>
                <ComboBox Grid.Column="1" MinWidth="200" AutomationProperties.Name="Phone"
                          Visibility="{x:Bind ViewModel.ManyDevices, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Devices}"
                          SelectedItem="{x:Bind ViewModel.SelectedDeviceItem, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:ToolsDevice">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Grid.Column="1" Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="14" Padding="14,8"
                        Visibility="{x:Bind ViewModel.SingleDevice, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource PrimaryBrush}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.HasPhone, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DeviceLabel, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- No phone yet: one calm card, never an error. -->
            <Border Grid.Row="1" Style="{StaticResource ExpressiveCard}" Padding="32" VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.NoPhone, Mode=OneWay}">
                <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE8EA;" FontSize="36" HorizontalAlignment="Left" Foreground="{ThemeResource PrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HasPhone, Mode=OneWay}">
                <tools:TypeSection Visibility="{x:Bind ViewModel.IsType, Mode=OneWay}" />
                <tools:RescueSection Visibility="{x:Bind ViewModel.IsRescue, Mode=OneWay}" />
                <tools:AppsSection Visibility="{x:Bind ViewModel.IsApps, Mode=OneWay}" />
                <tools:CaptureSection Visibility="{x:Bind ViewModel.IsCapture, Mode=OneWay}" />
                <tools:HealthSection Visibility="{x:Bind ViewModel.IsHealth, Mode=OneWay}" />
                <tools:SystemSection Visibility="{x:Bind ViewModel.IsSystem, Mode=OneWay}" />
                <tools:CommandsSection Visibility="{x:Bind ViewModel.IsCommands, Mode=OneWay}" />
                <tools:ConsoleSection Visibility="{x:Bind ViewModel.IsConsole, Mode=OneWay}" />
            </Grid>

            <!-- The command the last action ran (design rule 3). Click copies it. -->
            <HyperlinkButton Grid.Row="2" Padding="0" Visibility="{x:Bind ViewModel.HasLastCommand, Mode=OneWay}"
                             ToolTipService.ToolTip="Copy this command" Click="OnCopyCommand">
                <TextBlock Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                           Opacity="0.6" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
            </HyperlinkButton>
        </Grid>
    </Grid>
</Page>
