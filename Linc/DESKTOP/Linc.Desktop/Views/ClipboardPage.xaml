<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.ClipboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:views="using:Linc.Desktop.Views">

    <ScrollViewer x:Name="Scroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Column" views:PageLayout.Adaptive="True" Padding="32" Spacing="16">

            <!-- Search first; sending text to the phone sits behind its button (the owner). -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Clipboard" Style="{StaticResource HeadlineText}" />
                    <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" TextWrapping="Wrap" Opacity="0.8"
                               Text="What you copy on this PC or your phone, kept here and on the other device." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource FilledButton}"
                        AutomationProperties.Name="Send text to the phone">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                        <TextBlock Text="Send to phone" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="12" Width="420">
                                <TextBlock Text="Send text to your phone" Style="{StaticResource TitleText}" />
                                <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="200"
                                         PlaceholderText="Type or paste — it lands on the phone's clipboard"
                                         Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Text to send to the phone" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.IsNotConnected, Mode=OneWay}"
                                           Text="Connect your phone to send. The history still works." />
                                <Button Style="{StaticResource FilledButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.SendCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                                        <TextBlock Text="Send" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.SyncNowCommand}"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        ToolTipService.ToolTip="Sync now" AutomationProperties.Name="Sync now">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Center" Click="OnClearClick"
                        IsEnabled="{x:Bind ViewModel.HasHistory, Mode=OneWay}"
                        ToolTipService.ToolTip="Clear history" AutomationProperties.Name="Clear history">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </Grid>

            <!-- A plain TextBox, not an AutoSuggestBox: with the AutoSuggestBox the page measured wider
                 than the window and the column ran off the right edge (UI test, concerns-5). -->
            <Grid>
                <TextBox PlaceholderText="Search the history" Padding="36,6,10,6"
                         Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search the clipboard history" />
                <FontIcon Glyph="&#xE721;" FontSize="14" Opacity="0.7" Margin="12,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=TwoWay}" Severity="Informational"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HistoryOff, Mode=OneWay}"
                       Text="History is off: clips sync but aren't kept. Turn it on in Settings → Clipboard." />

            <!-- Empty state -->
            <StackPanel Spacing="8" Padding="0,32" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE77F;" FontSize="40" Opacity="0.6" />
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
                <TextBlock views:Explain.IsHelp="True" Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource BodyText}"
                           Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipGroupVm">
                        <StackPanel Spacing="2" Margin="0,8,0,0">
                            <TextBlock Text="{x:Bind Header}" Style="{StaticResource LabelText}" Foreground="{ThemeResource PrimaryBrush}" Margin="4,0,0,6" />
                            <!-- No ItemContainerTransitions: an entrance animation per row made the first
                                 load of a long history crawl (owner concerns §3). The rows arrive in
                                 batches instead (ClipboardViewModel.RebuildAsync). -->
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ItemsControl.ItemContainerTransitions>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClipRowVm">
                                        <Grid Background="{ThemeResource SurfaceContainerBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SecondaryContainerBrush}" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="{x:Bind SourceName}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                                           IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Text}" />
                                                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionText}" Opacity="0.7" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                                <Button Command="{x:Bind CopyCommand}" ToolTipService.ToolTip="Copy here" AutomationProperties.Name="Copy here"
                                                        Background="Transparent" BorderThickness="0" Padding="8">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                </Button>
                                                <Button Command="{x:Bind SendCommand}" ToolTipService.ToolTip="Send to phone" AutomationProperties.Name="Send to phone"
                                                        Background="Transparent" BorderThickness="0" Padding="8">
                                                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                                                </Button>
                                                <Button Command="{x:Bind PinCommand}" ToolTipService.ToolTip="{x:Bind PinLabel}" AutomationProperties.Name="{x:Bind PinLabel}"
                                                        Background="Transparent" BorderThickness="0" Padding="8">
                                                    <FontIcon Glyph="{x:Bind PinGlyph}" FontSize="14" />
                                                </Button>
                                                <Button Command="{x:Bind DeleteCommand}" ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete"
                                                        Background="Transparent" BorderThickness="0" Padding="8">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
