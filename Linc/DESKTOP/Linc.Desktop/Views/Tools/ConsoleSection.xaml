<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Linc.Desktop.Views.Tools.ConsoleSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views">

    <!-- Tools › Console (TOOLS.md §10): a dark terminal pane in both themes, the prompt under it. -->
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Console" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="Copy output" Padding="16,8"
                    IsEnabled="{x:Bind ViewModel.HasOutput, Mode=OneWay}" Click="OnCopyOutput" />
            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="Clear" Padding="16,8"
                    IsEnabled="{x:Bind ViewModel.HasOutput, Mode=OneWay}" Command="{x:Bind ViewModel.ClearCommand}" />
        </Grid>

        <Border Grid.Row="1" Background="#1E1E22" CornerRadius="20" Padding="16,12" MinHeight="240">
            <Grid>
                <TextBlock Text="Type a command below, like getprop ro.product.model or pm list packages -3."
                           FontFamily="Consolas" FontSize="13" Foreground="#8C8C96" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.NoOutput, Mode=OneWay}" />
                <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <TextBlock Text="{x:Bind ViewModel.Output, Mode=OneWay}" FontFamily="Consolas" FontSize="13"
                               Foreground="#E6E6EA" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Prompt" Style="{StaticResource ExpressiveTextBox}" FontFamily="Consolas"
                     PlaceholderText="adb shell command — Enter runs, ↑ ↓ for earlier ones"
                     AutomationProperties.Name="Command"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnPromptKeyDown" />
            <Button Grid.Column="1" Style="{StaticResource FilledButton}" Content="Run" Padding="24,12"
                    IsEnabled="{x:Bind ViewModel.NotRunning, Mode=OneWay}" Command="{x:Bind ViewModel.RunCommand}" />
        </Grid>

        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.RiskHint, Mode=OneWay}" Foreground="#C77700" FontSize="13" FontWeight="SemiBold"
                       Visibility="{x:Bind ViewModel.HasRiskHint, Mode=OneWay}" />
            <TextBlock Text="Commands run on the phone as typed, without root. Ones that keep running stop after 30 s."
                       Style="{StaticResource CaptionText}" views:Explain.IsHelp="True" />
        </StackPanel>
    </Grid>
</UserControl>
