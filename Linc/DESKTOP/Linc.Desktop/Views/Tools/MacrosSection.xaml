<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Linc.Desktop.Views.Tools.MacrosSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:svc="using:Linc.Desktop.Services.Tools"
    xmlns:vmt="using:Linc.Desktop.ViewModels.Tools">

    <!-- Tools › Macros (TOOLS.md §9): the macros on the left, each with Run; the open one's
         steps on the right, with Add step. -->
    <Grid ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The run line: what is running now, or how the last run went. -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource ExpressiveCard}" Padding="16,12"
                Visibility="{x:Bind ViewModel.HasRunText, Mode=OneWay}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon Glyph="&#xE783;" FontSize="18" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.RunFailed, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RunText, Mode=OneWay}" TextWrapping="Wrap" FontSize="14"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="2" Content="Stop" Visibility="{x:Bind ViewModel.Running, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StopRunCommand}" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Maximum="1" Value="{x:Bind ViewModel.RunProgress, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.Running, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- The macros. -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource FilledButton}" Command="{x:Bind ViewModel.NewCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New macro" />
                    </StackPanel>
                </Button>
                <DropDownButton Content="From a template" x:Name="TemplatesButton">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="TemplatesMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <ListView Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="Macros"
                      ItemsSource="{x:Bind ViewModel.Macros}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="CornerRadius" Value="{StaticResource ShapeLarge}" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vmt:MacroCard">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource FilledButton}" Padding="12,6" Click="OnRun"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" ToolTipService.ToolTip="Run">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Nothing open: what a macro is. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ExpressiveCard}" Padding="28" VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.NotEditing, Mode=OneWay}">
            <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE768;" FontSize="32" HorizontalAlignment="Left" Foreground="{ThemeResource PrimaryBrush}" />
                <TextBlock Text="Macros" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" views:Explain.IsHelp="True"
                           Text="A macro is a few steps run with one click: turn on Do Not Disturb, pause the music, mirror the phone. Click one to change its steps, or ▶ to run it. Steps marked ADB need the cable or wireless debugging; the others work over Linc's own connection." />
            </StackPanel>
        </Border>

        <!-- The open macro. -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12" Visibility="{x:Bind ViewModel.Editing, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource FilledButton}"
                        IsEnabled="{x:Bind ViewModel.NotRunning, Mode=OneWay}" Command="{x:Bind ViewModel.RunSelectedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" VerticalAlignment="Bottom" AutomationProperties.Name="Delete macro" ToolTipService.ToolTip="Delete"
                        Command="{x:Bind ViewModel.DeleteCommand}">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Bottom" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close"
                        Command="{x:Bind ViewModel.CloseEditorCommand}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>

            <!-- The steps, in order: drag to reorder, or ↑ ↓. -->
            <ListView x:Name="StepList" Grid.Row="1" SelectionMode="None" CanReorderItems="True" AllowDrop="True"
                      AutomationProperties.Name="Steps" ItemsSource="{x:Bind ViewModel.Steps}" DragItemsCompleted="OnStepsDragged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="CornerRadius" Value="{StaticResource ShapeLarge}" />
                        <Setter Property="Background" Value="{ThemeResource SurfaceContainerBrush}" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="Padding" Value="12,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vmt:MacroStepRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Number}" Opacity="0.6" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="8" Padding="8,2"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="What this step needs">
                                <TextBlock Text="{x:Bind Needs}" FontSize="11" />
                            </Border>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource QuietButton}" Padding="8" MinWidth="0" AutomationProperties.Name="Move up"
                                        Click="OnMoveUp"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                                <Button Style="{StaticResource QuietButton}" Padding="8" MinWidth="0" AutomationProperties.Name="Move down"
                                        Click="OnMoveDown"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                                <Button Style="{StaticResource QuietButton}" Padding="8" MinWidth="0" AutomationProperties.Name="Remove step"
                                        Click="OnRemoveStep"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Add step: a kind and what it acts on, or a command from the catalogue. -->
            <Border Grid.Row="2" Style="{StaticResource ExpressiveCard}" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Header="Add step" MinWidth="240" AutomationProperties.Name="Step kind"
                                  ItemsSource="{x:Bind ViewModel.Kinds}"
                                  SelectedItem="{x:Bind ViewModel.AddKindItem, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:MacroStepInfo">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                        <TextBlock Text="{x:Bind Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Header="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.AddExample, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.AddHasValue, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.AddValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnAddKeyDown" />
                        <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Add" Command="{x:Bind ViewModel.AddStepCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.AddProblem, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" FontSize="13"
                               Visibility="{x:Bind ViewModel.HasAddProblem, Mode=OneWay}" TextWrapping="Wrap" />
                    <AutoSuggestBox PlaceholderText="Or find a command: wifi off, dark mode, open app…" QueryIcon="Find"
                                    AutomationProperties.Name="Find a command" TextChanged="OnCommandSearch"
                                    SuggestionChosen="OnCommandChosen" DisplayMemberPath="Title" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
