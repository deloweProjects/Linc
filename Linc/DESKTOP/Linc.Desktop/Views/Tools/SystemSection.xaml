<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Linc.Desktop.Views.Tools.SystemSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views">

    <UserControl.Resources>
        <!-- A whole tile that turns on and off. -->
        <Style x:Key="SwitchTile" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="{StaticResource ShapeExtraLarge}" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource SurfaceContainerBrush}" />
        </Style>
        <!-- One option of a few (Off · 0.5× · 1×). -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource ShapeFull}" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource ExpressiveCard}">
            <Setter Property="Padding" Value="22" />
        </Style>
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="PrimaryContainerBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="PrimaryContainerBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="PrimaryContainerBrush" />
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="OnPrimaryContainerBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="OnPrimaryContainerBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="OnPrimaryContainerBrush" />
    </UserControl.Resources>

    <!-- Tools › System (TOOLS.md §6): six tiles, then More (radios, restart). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16" Padding="0,0,0,16">
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="150" />
                    <RowDefinition Height="Auto" MinHeight="150" />
                </Grid.RowDefinitions>

                <!-- Dark mode -->
                <ToggleButton Style="{StaticResource SwitchTile}" views:ChoiceButton.IsChoice="True"
                              AutomationProperties.Name="Dark mode"
                              IsChecked="{x:Bind ViewModel.DarkMode, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ToggleDarkModeCommand}">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE708;" FontSize="24" HorizontalAlignment="Left" />
                        <TextBlock Text="Dark mode" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="The phone's dark theme" FontSize="13" Opacity="0.75" views:Explain.IsHelp="True" />
                    </StackPanel>
                </ToggleButton>

                <!-- Stay awake while charging -->
                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchTile}" views:ChoiceButton.IsChoice="True"
                              AutomationProperties.Name="Stay awake"
                              IsChecked="{x:Bind ViewModel.StayAwake, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ToggleStayAwakeCommand}">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE7E8;" FontSize="24" HorizontalAlignment="Left" />
                        <TextBlock Text="Stay awake" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Screen stays on while charging" FontSize="13" Opacity="0.75" TextWrapping="Wrap" views:Explain.IsHelp="True" />
                    </StackPanel>
                </ToggleButton>

                <!-- Animations -->
                <Border Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE916;" FontSize="20" />
                            <TextBlock Text="Animations" Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource Chip}" Content="Off" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Animations off"
                                          IsChecked="{x:Bind ViewModel.AnimOff, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetAnimationsCommand}" CommandParameter="0" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource Chip}" Content="0.5×" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Animations half speed"
                                          IsChecked="{x:Bind ViewModel.AnimHalf, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetAnimationsCommand}" CommandParameter="0.5" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Chip}" Content="1×" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Animations normal"
                                          IsChecked="{x:Bind ViewModel.AnimNormal, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetAnimationsCommand}" CommandParameter="1" />
                        </Grid>
                        <TextBlock Text="Off makes the phone feel faster" Style="{StaticResource CaptionText}" views:Explain.IsHelp="True" />
                    </StackPanel>
                </Border>

                <!-- Screen timeout -->
                <Border Grid.Row="1" Style="{StaticResource Tile}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE823;" FontSize="20" />
                            <TextBlock Text="Screen timeout" Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource Chip}" Content="30 s" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Screen timeout 30 seconds"
                                          IsChecked="{x:Bind ViewModel.Timeout30s, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTimeoutCommand}" CommandParameter="30000" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource Chip}" Content="1 m" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Screen timeout 1 minute"
                                          IsChecked="{x:Bind ViewModel.Timeout1m, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTimeoutCommand}" CommandParameter="60000" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Chip}" Content="5 m" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Screen timeout 5 minutes"
                                          IsChecked="{x:Bind ViewModel.Timeout5m, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTimeoutCommand}" CommandParameter="300000" />
                            <ToggleButton Grid.Column="3" Style="{StaticResource Chip}" Content="10 m" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Screen timeout 10 minutes"
                                          IsChecked="{x:Bind ViewModel.Timeout10m, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTimeoutCommand}" CommandParameter="600000" />
                            <ToggleButton Grid.Column="4" Style="{StaticResource Chip}" Content="30 m" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Screen timeout 30 minutes"
                                          IsChecked="{x:Bind ViewModel.Timeout30m, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTimeoutCommand}" CommandParameter="1800000" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Brightness -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE706;" FontSize="20" />
                                <TextBlock Text="Brightness" Style="{StaticResource TitleText}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.BrightnessText, Mode=OneWay}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                        </Grid>
                        <Slider Minimum="0" Maximum="255" StepFrequency="1" AutomationProperties.Name="Brightness"
                                Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="16,6" Content="Auto"
                                      views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Auto brightness"
                                      IsChecked="{x:Bind ViewModel.AutoBrightness, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.ToggleAutoBrightnessCommand}" />
                    </StackPanel>
                </Border>

                <!-- Text size -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D2;" FontSize="20" />
                            <TextBlock Text="Text size" Style="{StaticResource TitleText}" />
                        </StackPanel>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource Chip}" Content="Small" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Text small"
                                          IsChecked="{x:Bind ViewModel.TextSmall, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTextSizeCommand}" CommandParameter="0.85" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource Chip}" Content="Default" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Text default"
                                          IsChecked="{x:Bind ViewModel.TextDefault, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTextSizeCommand}" CommandParameter="1.0" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Chip}" Content="Large" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Text large"
                                          IsChecked="{x:Bind ViewModel.TextLarge, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTextSizeCommand}" CommandParameter="1.15" />
                            <ToggleButton Grid.Column="3" Style="{StaticResource Chip}" Content="Larger" views:ChoiceButton.IsChoice="True"
                                          AutomationProperties.Name="Text larger"
                                          IsChecked="{x:Bind ViewModel.TextLarger, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.SetTextSizeCommand}" CommandParameter="1.3" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- More: radios and power, folded away. -->
            <Expander Header="More" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="32" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="Wi-Fi" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Wi-Fi"
                                          Content="{x:Bind ViewModel.WifiText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.Wifi, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleWifiCommand}" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock Text="Mobile data" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Mobile data"
                                          Content="{x:Bind ViewModel.MobileDataText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.MobileData, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleMobileDataCommand}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Text="Bluetooth" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Bluetooth"
                                          Content="{x:Bind ViewModel.BluetoothText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.Bluetooth, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleBluetoothCommand}" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Airplane mode" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Airplane mode"
                                          Content="{x:Bind ViewModel.AirplaneText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.Airplane, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleAirplaneCommand}" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock Text="Location" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Location"
                                          Content="{x:Bind ViewModel.LocationText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.Location, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleLocationCommand}" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Battery saver" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Battery saver"
                                          Content="{x:Bind ViewModel.BatterySaverText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.BatterySaver, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleBatterySaverCommand}" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <TextBlock Text="Night light" VerticalAlignment="Center" FontSize="14" />
                            <ToggleButton HorizontalAlignment="Right" MinWidth="72" CornerRadius="{StaticResource ShapeFull}"
                                          views:ChoiceButton.IsChoice="True" AutomationProperties.Name="Night light"
                                          Content="{x:Bind ViewModel.NightLightText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.NightLight, Mode=OneWay}"
                                          Command="{x:Bind ViewModel.ToggleNightLightCommand}" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="SCREEN" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                    <Button Content="Reset screen size and rotation" Style="{StaticResource TonalButton}" Padding="20,10"
                            Command="{x:Bind ViewModel.ResetScreenCommand}" />
                    <TextBlock Text="If mirroring with &quot;Fill this monitor&quot; left the phone stretched or sideways." Style="{StaticResource CaptionText}" views:Explain.IsHelp="True" />

                    <TextBlock Text="RESTART" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Restart" Style="{StaticResource TonalButton}" Padding="20,10"
                                Command="{x:Bind ViewModel.RestartCommand}" />
                        <Button Content="Recovery" Style="{StaticResource QuietButton}" Padding="20,10"
                                Command="{x:Bind ViewModel.RecoveryCommand}" />
                        <Button Content="Power off" Style="{StaticResource QuietButton}" Padding="20,10"
                                Command="{x:Bind ViewModel.PowerOffCommand}" />
                    </StackPanel>
                    <TextBlock Text="Linc reconnects when the phone is back." Style="{StaticResource CaptionText}" views:Explain.IsHelp="True" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
