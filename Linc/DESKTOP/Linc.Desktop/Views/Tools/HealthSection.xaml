<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Linc.Desktop.Views.Tools.HealthSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Linc.Desktop.Views"
    xmlns:vmt="using:Linc.Desktop.ViewModels.Tools">

    <!-- Tools › Health (TOOLS.md §5): battery, temperature, storage, live CPU and memory, the
         busiest apps; the phone's details folded away below. Refreshes every 3 s while open. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid ColumnSpacing="16" RowSpacing="16" Padding="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Battery: a ring with the level in the middle. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="22" MinHeight="230">
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                        <ProgressRing IsIndeterminate="False" Minimum="0" Maximum="100" Width="140" Height="140"
                                      Value="{x:Bind ViewModel.BatteryLevel, Mode=OneWay}"
                                      AutomationProperties.Name="Battery level" />
                        <TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource OnSurfaceBrush}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.BatteryStatus, Mode=OneWay}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.BatteryTemperature, Mode=OneWay}" Style="{StaticResource LabelText}"
                               HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </Border>

            <!-- Phone temperature, with a colour state. -->
            <Border Grid.Column="1" Style="{StaticResource ExpressiveCard}" Padding="22">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Phone temperature" Style="{StaticResource CaptionText}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}" FontSize="44" FontWeight="Bold"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               Visibility="{x:Bind ViewModel.HasTemperature, Mode=OneWay}" />
                    <Border HorizontalAlignment="Left" CornerRadius="12" Padding="12,5" Background="{ThemeResource SecondaryContainerBrush}"
                            Visibility="{x:Bind ViewModel.IsCool, Mode=OneWay}">
                        <TextBlock Text="Cool" FontSize="13" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                    </Border>
                    <Border HorizontalAlignment="Left" CornerRadius="12" Padding="12,5" Background="{ThemeResource TertiaryContainerBrush}"
                            Visibility="{x:Bind ViewModel.IsWarm, Mode=OneWay}">
                        <TextBlock Text="Warm" FontSize="13" Foreground="{ThemeResource OnTertiaryContainerBrush}" />
                    </Border>
                    <Border HorizontalAlignment="Left" CornerRadius="12" Padding="12,5" Background="{ThemeResource ErrorContainerBrush}"
                            Visibility="{x:Bind ViewModel.IsHot, Mode=OneWay}">
                        <TextBlock Text="Hot" FontSize="13" Foreground="{ThemeResource OnErrorContainerBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Storage. -->
            <Border Grid.Column="2" Style="{StaticResource ExpressiveCard}" Padding="22">
                <StackPanel Spacing="12" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasStorage, Mode=OneWay}">
                    <TextBlock Text="Storage" Style="{StaticResource CaptionText}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StorageFree, Mode=OneWay}" FontSize="28" FontWeight="Bold"
                               Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Minimum="0" Maximum="100" Height="14" CornerRadius="7"
                                 Value="{x:Bind ViewModel.StorageUsedPercent, Mode=OneWay}"
                                 AutomationProperties.Name="Storage used" />
                    <TextBlock Text="{x:Bind ViewModel.StorageTotal, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </Border>

            <!-- CPU and memory over the last few minutes. -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ExpressiveCard}" Padding="22">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <Grid x:Name="CpuGraph" Height="120" AutomationProperties.Name="CPU use over the last few minutes">
                            <Polyline x:Name="CpuLine" Stroke="{ThemeResource PrimaryBrush}" StrokeThickness="3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" Visibility="{x:Bind ViewModel.HasMemory, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <Grid x:Name="MemoryGraph" Height="120" AutomationProperties.Name="Memory use over the last few minutes">
                            <Polyline x:Name="MemoryLine" Stroke="{ThemeResource OnTertiaryContainerBrush}" StrokeThickness="3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The busiest apps, each with Stop. -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ExpressiveCard}" Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock Text="Busy apps" Style="{StaticResource CaptionText}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.BusyApps}" Visibility="{x:Bind ViewModel.HasBusyApps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmt:BusyAppItem">
                                <Grid ColumnSpacing="8" Padding="0,2" ToolTipService.ToolTip="{x:Bind Package}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CpuText}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                    <Button Grid.Column="2" Content="Stop" Tag="{x:Bind Package}" Click="OnStopApp"
                                            Style="{StaticResource QuietButton}" Padding="12,4" BorderThickness="0"
                                            Foreground="{ThemeResource PrimaryBrush}"
                                            AutomationProperties.Name="{x:Bind StopName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The phone's details, folded away. -->
            <Expander Grid.Row="2" Grid.ColumnSpan="3" Header="Phone details" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmt:DetailRow">
                                <Grid ColumnSpacing="16" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Copy all" Style="{StaticResource TonalButton}" Padding="20,8" Click="OnCopyDetails" />
                </StackPanel>
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>
