<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Linc.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:views="using:Linc.Desktop.Views">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- The page's centred column (PageLayout.Adaptive): the cards run its full width. -->
        <StackPanel views:PageLayout.Adaptive="True" Padding="32" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource HeadlineText}" />

            <TextBlock
                Style="{StaticResource BodyText}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" />

            <!-- Sync -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sync" Style="{StaticResource TitleText}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Clipboard sync" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Phone → PC works while Linc is open on the phone (an Android limit)."
                                       Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.ClipboardSyncEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Notification relay" Style="{StaticResource BodyText}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.NotificationSyncEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Clipboard history (D-083): on by default, 500 items per phone. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Clipboard" Style="{StaticResource TitleText}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keep history" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Saved on this PC, per phone. Off: clips still sync but aren't kept. Copies Windows marks as private (password managers) are never kept or sent." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="History size" Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="100" GroupName="ClipboardSize" IsChecked="{x:Bind ViewModel.IsClipboard100, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=OneWay}" />
                            <RadioButton Content="500" GroupName="ClipboardSize" IsChecked="{x:Bind ViewModel.IsClipboard500, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=OneWay}" />
                            <RadioButton Content="2,000" GroupName="ClipboardSize" IsChecked="{x:Bind ViewModel.IsClipboard2000, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notification history (M9b, D-045): opt-in, default OFF. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Notification history" Style="{StaticResource TitleText}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The switch's own label always shows; only the explanation follows
                             Settings › Show explanations (it used to be the label, so hiding
                             explanations left a switch with no name). -->
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Keep notification history" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True"
                                Text="Save notifications on this PC so you can see them after they are dismissed elsewhere."
                                Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            AutomationProperties.Name="Keep notification history"
                            IsOn="{x:Bind ViewModel.NotificationHistoryEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- Retention picker: 7 / 30 / 90 days, default 30. Disabled while the toggle is off (§2.6). -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Keep history for" Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="7 days" IsChecked="{x:Bind ViewModel.IsHistory7Days, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsHistoryRetentionEnabled, Mode=OneWay}" GroupName="HistoryRetention" />
                            <RadioButton Content="30 days" IsChecked="{x:Bind ViewModel.IsHistory30Days, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsHistoryRetentionEnabled, Mode=OneWay}" GroupName="HistoryRetention" />
                            <RadioButton Content="90 days" IsChecked="{x:Bind ViewModel.IsHistory90Days, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsHistoryRetentionEnabled, Mode=OneWay}" GroupName="HistoryRetention" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Clear history" Click="OnClearHistoryClick" ToolTipService.ToolTip="Delete every stored notification, for all devices" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="When on, notification bodies are stored on this PC." />
                        <LineBreak />
                        <Run Text="History is kept per device. Turning it OFF stops new ones but does NOT delete what is already stored — use Clear history for that." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Connection -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Connection" Style="{StaticResource TitleText}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Allow USB connections" Style="{StaticResource BodyText}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.AllowUsbConnections, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Background connection — the phone finds this PC by itself, no ADB needed"
                            Style="{StaticResource BodyText}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.BackgroundConnectionEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="New connection engine — finds the phone faster on any Wi-Fi, and short drops never show. Off: the way Linc always connected"
                            Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.LincLinkEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Encrypt Wi-Fi links — when Linc rides plain ADB over Wi-Fi (port 5555, which anyone on the network could read), switch to the encrypted direct link. Mirror, Tools and fast file copies then need wireless debugging or the cable. Needs the new connection engine"
                            Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.EncryptWifiLinks, Mode=TwoWay}" />
                    </Grid>
                    <!-- PC hotspot: the PC's own Wi-Fi for the phone, even with no internet (LincLink step 6, by hand). -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="PC hotspot — no shared Wi-Fi and no cable? This PC makes its own Wi-Fi for the phone, even with no internet (Windows' own Mobile Hotspot refuses then). The phone joins it once; Linc finds the PC on it by itself"
                                Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HotspotStatus" Text="Off" Style="{StaticResource BodyText}" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="HotspotButton" Grid.Column="1" Content="Start PC hotspot" Click="OnHotspotClick" VerticalAlignment="Top" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Start the PC hotspot when the phone is near — when this PC hears the phone over Bluetooth but can't reach it for 20 s, it starts the hotspot and the phone joins it by itself (the phone learns the network while connected, and asks you once). Off again after 3 minutes if the phone doesn't come. Needs the new connection engine"
                            Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.AutoHotspot, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel x:Name="HotspotDetails" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                        <Image x:Name="HotspotQr" Width="140" Height="140" />
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="On the phone: scan this with the camera, or join" Style="{StaticResource BodyText}" />
                            <TextBlock x:Name="HotspotSsid" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="HotspotPassword" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Content="Resume auto-reconnect"
                            Command="{x:Bind ViewModel.ResumeAutomaticCommand}"
                            Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />
                        <Button Content="Connection Doctor" Click="OnConnectionDoctorClick"
                                ToolTipService.ToolTip="Checks what can stop the PC and phone finding each other (firewall, network type, VPN, Wi-Fi isolation, the phone's battery settings) and fixes what it can" />
                        <Button Content="Clear saved phone data" Command="{x:Bind ViewModel.ClearDeviceDataCommand}" ToolTipService.ToolTip="Drops the offline copy of this phone (stats, wallpaper, photo thumbnails) without unpairing it" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Finding your phone (LincLink helpers, owner 2026-11-01): Bluetooth both ways, home
                 networks, and what the phone last said. SettingsPage.xaml.cs fills it (NearbyRules). -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Finding your phone" Style="{StaticResource TitleText}" />
                    <TextBlock views:Explain.IsHelp="True"
                               Text="The PC and the phone hear each other over Bluetooth and swap a few status clues (linked, Wi-Fi, hotspot), so they start looking for each other at once and the log says why they can't. Nothing else goes over Bluetooth. After 10 minutes with no phone, Linc looks less often to save power, and at full speed again the moment anything changes."
                               Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="NearbyBluetooth" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="NearbyPhone" Style="{StaticResource BodyText}" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="NearbyBluetoothButton" Grid.Column="1" Content="Turn Bluetooth on" Click="OnNearbyBluetoothClick" VerticalAlignment="Top" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NearbyHome" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <Button x:Name="NearbyHomeButton" Grid.Column="1" Content="This is home" Click="OnNearbyHomeClick" VerticalAlignment="Top" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="At home, turn Bluetooth on — on this PC, and on the phone whenever the cable or wireless debugging reaches it. The phone can also ask you to turn its Bluetooth on at home (Linc on the phone › Settings › Finding your PC)"
                            Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="NearbyBluetoothAtHome" Grid.Column="1" OnContent="On" OffContent="Off" Toggled="OnNearbyBluetoothAtHomeToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Startup (M12e): opt-in, default OFF. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Startup" Style="{StaticResource TitleText}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Start Linc when I sign in" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Linc opens quietly in the notification area." Style="{StaticResource BodyText}" Opacity="0.7" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance (M18 B1): dynamic colour on by default, neutral ramp underneath. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{StaticResource TitleText}" />
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Navigation" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Where the pages live: icons in a bar along the bottom (hover one to see its name), or down the left with their names." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="NavStyle" Content="Floating bar" IsChecked="{x:Bind ViewModel.FloatingNav, Mode=TwoWay}" />
                            <RadioButton GroupName="NavStyle" Content="Side rail" IsChecked="{x:Bind ViewModel.SideRailNav, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Font" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="The typeface across Linc. Default is Windows&apos; own Segoe UI." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- AppFonts.Keep: these previews stay in their own typefaces whatever the app uses. -->
                        <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.AppFontIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Font" views:AppFonts.Keep="True">
                            <RadioButton AutomationProperties.Name="Default font">
                                <StackPanel Spacing="0" MinWidth="96">
                                    <TextBlock Text="Aa" FontFamily="Segoe UI Variable Text" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Default" FontFamily="Segoe UI Variable Text" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Inter font">
                                <StackPanel Spacing="0" MinWidth="96">
                                    <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/Inter.ttf#Inter" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Inter" FontFamily="ms-appx:///Assets/Fonts/Inter.ttf#Inter" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Plus Jakarta Sans font">
                                <StackPanel Spacing="0" MinWidth="96">
                                    <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/PlusJakartaSans.ttf#Plus Jakarta Sans" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Plus Jakarta Sans" FontFamily="ms-appx:///Assets/Fonts/PlusJakartaSans.ttf#Plus Jakarta Sans" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Manrope font">
                                <StackPanel Spacing="0" MinWidth="96">
                                    <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/Manrope.ttf#Manrope" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Manrope" FontFamily="ms-appx:///Assets/Fonts/Manrope.ttf#Manrope" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Outfit font">
                                <StackPanel Spacing="0" MinWidth="96">
                                    <TextBlock Text="Aa" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Outfit" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Wallpaper as background" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Your phone&apos;s wallpaper, blurred, behind everything. Off: the plain background, in your phone&apos;s colours, with solid cards." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.WallpaperBackdrop, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Linc Island" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="A dark pill at the top of your phone on Home (and in the title bar on other pages) that shows what&apos;s happening: a file sending, a call, music, mirroring, reconnecting, low battery. Click it for buttons." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      AutomationProperties.AutomationId="LiveIslandToggle"
                                      IsOn="{x:Bind ViewModel.LiveIsland, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Linc Bubble" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="A small Linc bubble on your desktop, over every app. Drag it anywhere; it tucks itself into the screen edge when you're not using it. It grows into the island when something happens, and a click opens Linc's shortcuts (mirror, ring, send the clipboard, PC hotspot…)." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.LiveBubble, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.LiveBubble, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Bubble size" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="How big the Linc Bubble is on your desktop. Its shortcuts: click the bubble, then the pencil." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <Slider Grid.Column="1" Width="200" VerticalAlignment="Center"
                                Minimum="28" Maximum="64" StepFrequency="2" SmallChange="2"
                                Value="{x:Bind ViewModel.BubbleSizeValue, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.LiveBubble, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="When the bubble is idle" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Slim tab: it slides into the screen edge as a thin tab. Hidden: nothing shows until you move the pointer to that edge or something happens. Always a bubble: it stays as it is." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                                  SelectedIndex="{x:Bind ViewModel.BubbleIdleIndex, Mode=TwoWay}">
                            <x:String>Slim tab</x:String>
                            <x:String>Hidden</x:String>
                            <x:String>Always a bubble</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Clock on Home" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="The time and date on your phone&apos;s wallpaper, like its lock screen." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.HomeClock, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Clock style" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="How the clock on Home looks." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ClockStyleIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Clock style">
                            <RadioButton AutomationProperties.Name="Classic clock">
                                <StackPanel Spacing="4">
                                    <Border Width="116" Height="68" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3A3A3A" Offset="0" />
                                                <GradientStop Color="#FF121212" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Tuesday, 20 October" FontSize="7" FontWeight="Medium" Foreground="White" Opacity="0.92" HorizontalAlignment="Center" />
                                            <TextBlock Text="9:41" FontSize="32" FontWeight="Light" CharacterSpacing="-40" Foreground="White" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Classic" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Bold clock">
                                <StackPanel Spacing="4">
                                    <Border Width="116" Height="68" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3A3A3A" Offset="0" />
                                                <GradientStop Color="#FF121212" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="TUESDAY, 20 OCTOBER" FontSize="6" FontWeight="SemiBold" CharacterSpacing="160" Foreground="White" Opacity="0.92" HorizontalAlignment="Center" />
                                            <TextBlock Text="9:41" FontSize="30" FontWeight="Bold" CharacterSpacing="-60" Foreground="White" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Bold" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Stacked clock">
                                <StackPanel Spacing="4">
                                    <Border Width="116" Height="68" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3A3A3A" Offset="0" />
                                                <GradientStop Color="#FF121212" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock FontSize="26" FontWeight="Medium" CharacterSpacing="-20" Foreground="White"
                                                   TextAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Run Text="09" /><LineBreak /><Run Text="41" />
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="Stacked" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Serif clock">
                                <StackPanel Spacing="4">
                                    <Border Width="116" Height="68" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3A3A3A" Offset="0" />
                                                <GradientStop Color="#FF121212" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Tuesday, 20 October" FontSize="8" FontFamily="ms-appx:///Assets/Fonts/DMSerifDisplay.ttf#DM Serif Display" Foreground="White" Opacity="0.92" HorizontalAlignment="Center" />
                                            <TextBlock Text="9:41" FontSize="32" FontFamily="ms-appx:///Assets/Fonts/DMSerifDisplay.ttf#DM Serif Display" CharacterSpacing="-10" Foreground="White" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Serif" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Minimal clock">
                                <StackPanel Spacing="4">
                                    <Border Width="116" Height="68" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF3A3A3A" Offset="0" />
                                                <GradientStop Color="#FF121212" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                            <TextBlock Text="9:41" FontSize="17" FontWeight="SemiLight" Foreground="White" HorizontalAlignment="Center" />
                                            <TextBlock Text="Tuesday, 20 October 2026" FontSize="8" Foreground="White" Opacity="0.85" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Minimal" FontSize="12" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Use my phone&apos;s colours" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Tints Linc with your phone wallpaper&apos;s main colour. Off uses Linc&apos;s own black-and-white theme." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.UsePhoneColours, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Show explanations" Style="{StaticResource BodyText}" />
                            <TextBlock Text="The short lines that explain each setting. Warnings, errors and the reason something can't be used always show."
                                       Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.ShowExplanations, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mirror PC (D-087): the always-works switch for PCs whose graphics encoder misbehaves. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Mirror PC" Style="{StaticResource TitleText}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Use software encoding" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Turn on if Mirror PC won't start or freezes. Uses more CPU, but works on any PC. Linc already switches by itself when the graphics chip's encoder fails."
                                       Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.ForceSoftwareEncoding, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Phone as microphone (D-071): the virtual cable Voice Access hears the phone through. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Phone as microphone" Style="{StaticResource TitleText}" />
                    <TextBlock views:Explain.IsHelp="True"
                        Text="Windows Voice Access can hear you through your phone. Windows only accepts a microphone a driver provides, so Linc sets up VB-CABLE, VB-Audio&apos;s free virtual audio cable, downloaded from vb-audio.com. Your own microphone stays the default except while the phone is in use."
                        Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="CableStatus" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CableInstallButton" Content="Set up" Click="OnCableInstallClick" />
                        <Button x:Name="CableRemoveButton" Content="Remove" Click="OnCableRemoveClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates (M19 C3): one switch, default ON. There is no address to configure -
                 the manifest is Releases/update.json in Linc's own repo, baked in at build time. -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Updates" Style="{StaticResource TitleText}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Keep Linc up to date" Style="{StaticResource BodyText}" />
                            <TextBlock views:Explain.IsHelp="True" Text="Off means Linc never checks for anything. You can still update by hand from the Releases page." Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            OnContent="On" OffContent="Off"
                            IsOn="{x:Bind ViewModel.UpdatesEnabled, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Style="{StaticResource BodyText}" Opacity="0.7" TextWrapping="Wrap" />
                    <Button Content="Check now" Command="{x:Bind ViewModel.CheckForUpdatesNowCommand}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.UpdateCheckResult, Mode=OneWay}"
                        Style="{StaticResource BodyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasUpdateCheckResult, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Paired devices (M2a): the management home the tab strip's +/close flow complements -->
            <Border
                Style="{StaticResource ExpressiveCard}"
                Padding="20,16"
                Visibility="{x:Bind ViewModel.HasKnownDevices, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Devices" Style="{StaticResource TitleText}" />
                    <TextBlock views:Explain.IsHelp="True"
                        Style="{StaticResource BodyText}"
                        Text="Every phone paired with this PC. Open switches to it (and re-opens a closed tab); Remove unpairs it and deletes its saved copy — the same as Remove completely on its tab." />
                    <!-- M15c A2: the limit, stated where a phone gets added rather than after. -->
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowOneAtATimeNote, Mode=OneWay}"
                        Text="{x:Bind ViewModel.OneAtATimeText, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.KnownDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KnownDeviceVm">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Model}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{x:Bind Serial}" FontFamily="Consolas" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind StateText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Open"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind SetActiveCommand}"
                                        Visibility="{x:Bind IsNotActive}" />
                                    <Button
                                        Grid.Column="2"
                                        Content="Remove…"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ForgetCommand}"
                                        ToolTipService.ToolTip="Unpair this phone and delete its saved copy (asks first)" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ADB status -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="ADB status" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                        <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshDevicesCommand}" Margin="16,0,0,0" />
                        <Button Content="Restart ADB server" Command="{x:Bind ViewModel.RestartAdbServerCommand}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AdbPathText, Mode=OneWay}" Style="{StaticResource BodyText}" />

                    <TextBlock Text="Devices" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdbDeviceVm">
                                <TextBlock>
                                    <Run Text="{x:Bind Serial}" FontFamily="Consolas" />
                                    <Run Text=" — " />
                                    <Run Text="{x:Bind State}" />
                                    <Run Text=" — " />
                                    <Run Text="{x:Bind Model}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Text="Port forwards (connected device)"
                        Style="{StaticResource BodyText}"
                        FontWeight="SemiBold"
                        Visibility="{x:Bind ViewModel.HasConnectedDevice, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Forwards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ForwardVm">
                                <TextBlock FontFamily="Consolas">
                                    <Run Text="{x:Bind Local}" />
                                    <Run Text=" → " />
                                    <Run Text="{x:Bind Remote}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Shell command -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Run an ADB shell command" Style="{StaticResource TitleText}" />
                    <TextBlock
                        Style="{StaticResource BodyText}"
                        Foreground="{ThemeResource ErrorBrush}"
                        Text="Runs directly on your phone via ADB shell. Powerful — mistakes here can affect your phone. Use with care." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            Style="{StaticResource ExpressiveTextBox}"
                            Width="440"
                            PlaceholderText="e.g. dumpsys battery"
                            Text="{x:Bind ViewModel.ShellCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind ViewModel.HasConnectedDevice, Mode=OneWay}" />
                        <Button
                            Content="Run"
                            Style="{StaticResource FilledButton}"
                            Command="{x:Bind ViewModel.RunShellCommandCommand}"
                            IsEnabled="{x:Bind ViewModel.HasConnectedDevice, Mode=OneWay}" />
                    </StackPanel>
                    <Border
                        Background="{ThemeResource SurfaceContainerHighBrush}"
                        CornerRadius="{StaticResource ShapeLarge}"
                        Padding="12"
                        MinHeight="80"
                        MaxHeight="240">
                        <ScrollViewer>
                            <TextBlock
                                Text="{x:Bind ViewModel.ShellOutput, Mode=OneWay}"
                                FontFamily="Consolas"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Logs -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Logs" Style="{StaticResource TitleText}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Open log folder" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                        <Button Content="Clear logs" Command="{x:Bind ViewModel.ClearLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About (links shared with the phone's Settings → About: service/ProjectLinks.kt;
                 authorship and third-party credits as in the repository's NOTICE). -->
            <Border Style="{StaticResource ExpressiveCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="About" Style="{StaticResource TitleText}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Source="ms-appx:///Assets/linc.png"
                            Width="48" Height="48"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Linc" Style="{StaticResource TitleText}" />
                            <TextBlock
                                Style="{StaticResource BodyText}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="Made by " /><Hyperlink NavigateUri="https://github.com/deloweProjects/Linc">deloweProjects</Hyperlink><Run Text=" (delowe, @delow3)." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="Free and open source under the " /><Hyperlink NavigateUri="https://github.com/deloweProjects/Linc/blob/main/LICENSE">MIT License</Hyperlink><Run Text=". " /><Run Text="{x:Bind ViewModel.CopyrightText}" /><Run Text="." />
                    </TextBlock>

                    <!-- Two columns, so the links wrap instead of running off a narrow window. -->
                    <Grid ColumnSpacing="8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <HyperlinkButton Content="Telegram channel" NavigateUri="https://t.me/LincApp" ToolTipService.ToolTip="News, new versions and help — t.me/LincApp" />
                        <HyperlinkButton Grid.Column="1" Content="Source code on GitHub" NavigateUri="https://github.com/deloweProjects/Linc" />
                        <HyperlinkButton Grid.Row="1" Content="Report a problem" NavigateUri="https://github.com/deloweProjects/Linc/issues" />
                        <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="Licences and notices" Command="{x:Bind ViewModel.OpenNoticesCommand}" ToolTipService.ToolTip="The licences of everything Linc ships with" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Built with" Style="{StaticResource SectionLabel}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="scrcpy (screen mirroring) — Apache License 2.0, © Genymobile and Romain Vimont" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Android Debug Bridge (adb) — Apache License 2.0, © The Android Open Source Project" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="FFmpeg, SDL2 and libusb (used by scrcpy) — LGPL-2.1, zlib and LGPL-2.1" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Quick Share protocol definitions — Apache License 2.0, © Google LLC" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="DM Serif Display, Inter, Manrope, Outfit and Plus Jakarta Sans fonts — SIL Open Font License 1.1" />
                        <TextBlock Style="{StaticResource CaptionText}" Text=".NET 8, Windows App SDK (WinUI 3), CommunityToolkit.Mvvm, AdvancedSharpAdbClient, H.NotifyIcon, SQLite and others — each under its own licence" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
