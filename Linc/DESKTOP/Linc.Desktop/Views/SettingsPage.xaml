<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (the owner, 2026-11-03: "fix PC app settings UI bro, you can do better, you can even make
    new pages for settings collections"). A home of cards, one per collection, each saying how it's
    set right now; a card opens its own page (Views/Settings/*Settings.xaml). The search box finds
    any setting by name across all of them. The collections and their cards are listed once, in
    SettingsPage.xaml.cs (Categories); a new setting is a SettingRow in its collection's page.
-->
<Page
    x:Class="Linc.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Linc.Desktop.ViewModels"
    xmlns:views="using:Linc.Desktop.Views"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
    </Page.KeyboardAccelerators>

    <ScrollViewer x:Name="Scroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel views:PageLayout.Adaptive="True" views:PageLayout.MaxContentWidth="1040" Padding="32" Spacing="16">

            <!-- Title (or back + the open page's name) and the search box. -->
            <Grid ColumnSpacing="16" RowSpacing="12" views:PageLayout.StackBelow="720">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource IconTonalButton}" Width="44" Height="44" CornerRadius="22"
                            Visibility="Collapsed" Click="OnBackClick" AutomationProperties.Name="Back to Settings"
                            ToolTipService.ToolTip="Back to Settings (Esc)">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <FontIcon x:Name="TitleIcon" FontSize="24" Visibility="Collapsed" VerticalAlignment="Center"
                              Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock x:Name="TitleText" Text="Settings" Style="{StaticResource HeadlineText}" VerticalAlignment="Center" />
                </StackPanel>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" CornerRadius="20"
                                PlaceholderText="Find a setting" QueryIcon="Find"
                                AutomationProperties.Name="Find a setting"
                                TextChanged="OnSearchTextChanged" />
            </Grid>

            <!-- What the last action did ("History kept for 30 days.", "Switched to Pixel 7."). -->
            <Border Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="16" Padding="16,10" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource OnSecondaryContainerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="14"
                               Foreground="{ThemeResource OnSecondaryContainerBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ===== Settings home ===== -->
            <StackPanel x:Name="HomeView" Spacing="16">
                <!-- Linc itself, at the top: opens About. -->
                <Button x:Name="AboutBanner" Click="OnAboutBannerClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource PrimaryContainerBrush}" Foreground="{ThemeResource OnPrimaryContainerBrush}"
                        BorderThickness="0" CornerRadius="28" Padding="22,18" AutomationProperties.Name="About Linc">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/linc-bubble.png" Width="60" Height="60" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppName}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" FontSize="13" Opacity="0.8" />
                            <TextBlock FontSize="13" Opacity="0.8" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind ViewModel.PhoneAboutTitle, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="About" FontWeight="SemiBold" VerticalAlignment="Center" views:PageLayout.HideBelow="560" />
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </StackPanel>
                    </Grid>
                </Button>

                <ItemsRepeater x:Name="CategoryGrid" ItemsSource="{x:Bind Categories}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinItemHeight="92" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsCategoryVm">
                            <Button Style="{StaticResource ActionTile}" Background="{ThemeResource SurfaceContainerBrush}"
                                    VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="24" Padding="18,16"
                                    Command="{x:Bind OpenCommand}" AutomationProperties.Name="{x:Bind Title}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource PrimaryContainerBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- ===== The collections' pages: one shows when its card is opened, all of them (filtered)
                 while searching. SettingsPage.xaml.cs fills this from Categories. ===== -->
            <StackPanel x:Name="Sections" />

            <StackPanel x:Name="NoMatches" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40,0,0">
                <FontIcon Glyph="&#xE721;" FontSize="36" Opacity="0.5" />
                <TextBlock x:Name="NoMatchesText" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
