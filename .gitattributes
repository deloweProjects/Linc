* text=auto

# Gradle wrapper scripts need fixed line endings
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.sh text eol=lf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary
*.apk binary
*.zip binary
*.db binary
*.pfx binary
*.webp binary
scrcpy-server binary
