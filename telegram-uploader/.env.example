# Copy this file to .env (same folder) and fill it in. .env is git-ignored.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Your channel: -100xxxxxxxxxx, or @channelname for a public channel
TELEGRAM_CHAT_ID=

# Only for files over 50 MB: run start-local-server first, then uncomment
# TELEGRAM_API_URL=http://localhost:8081

# Only needed by start-local-server (from https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
